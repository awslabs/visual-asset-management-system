{
    "name": "vra-release-operator",
    "description": "Drives one VAMS release automation workflow (W0-W10) end to end through the vra MCP tools (CLI as fallback), branching on exit codes and stopping at every human gate.",
    "prompt": "You are the release operator for a customer fork of VAMS. Read skill/SKILL.md in full, then the workflow file it names in skill/workflows/, and follow them exactly; they override this prompt. Use the vra MCP tools for every engine action; use shell only for a vra command that has no tool (vra setup, vra merge --abort) and for read-only git. Branch on exit codes per SKILL.md section 3 (a tool error carries exitCode). Delegate conflicts to vra-conflict-resolver, failure classification to vra-failure-triager and the end-of-run summary to vra-reporter. At a [HUMAN] step ask one clear question and wait; never assume the answer.",
    "includeMcpJson": false,
    "mcpServers": {
        "vra": {
            "command": "vra",
            "args": ["mcp"],
            "env": {
                "VRA_AGENT": "1",
                "VRA_MCP_ENABLE_WRITES": "true",
                "VRA_MCP_ENABLE_GATED": "false"
            },
            "timeout": 21600000
        }
    },
    "tools": [
        "@vra",
        "glob",
        "grep",
        "read",
        "shell",
        "subagent/vra-conflict-resolver",
        "subagent/vra-failure-triager",
        "subagent/vra-reporter",
        "use_subagent",
        "write"
    ],
    "allowedTools": [
        "read",
        "glob",
        "grep",
        "use_subagent",
        "@vra/status",
        "@vra/report",
        "@vra/ledger_validate",
        "@vra/ledger_show",
        "@vra/ledger_diff",
        "@vra/ledger_graph",
        "@vra/preflight",
        "@vra/sync_dry_run",
        "@vra/history_verify",
        "@vra/history_show",
        "@vra/home_show",
        "@vra/iam_verify",
        "@vra/pipeline_status",
        "@vra/sync",
        "@vra/merge",
        "@vra/merge_continue",
        "@vra/build",
        "@vra/test",
        "@vra/backup",
        "@vra/resume",
        "@vra/watch",
        "@vra/iam_plan",
        "@vra/pipeline_plan",
        "@vra/pipeline_sync_ledger"
    ],
    "toolsSettings": {
        "shell": {
            "allowedCommands": [
                "vra status",
                "vra status .*",
                "vra --json status",
                "vra --json status .*",
                "vra report",
                "vra report .*",
                "vra --json report",
                "vra --json report .*",
                "vra ledger validate",
                "vra ledger validate .*",
                "vra --json ledger validate",
                "vra --json ledger validate .*",
                "vra ledger show",
                "vra ledger show .*",
                "vra --json ledger show",
                "vra --json ledger show .*",
                "vra ledger diff",
                "vra ledger diff .*",
                "vra --json ledger diff",
                "vra --json ledger diff .*",
                "vra ledger graph",
                "vra ledger graph .*",
                "vra --json ledger graph",
                "vra --json ledger graph .*",
                "vra history verify",
                "vra history verify .*",
                "vra --json history verify",
                "vra --json history verify .*",
                "vra history show",
                "vra history show .*",
                "vra --json history show",
                "vra --json history show .*",
                "vra home show",
                "vra home show .*",
                "vra --json home show",
                "vra --json home show .*",
                "vra preflight",
                "vra preflight .*",
                "vra --json preflight",
                "vra --json preflight .*",
                "vra iam verify",
                "vra iam verify .*",
                "vra --json iam verify",
                "vra --json iam verify .*",
                "vra pipeline status",
                "vra pipeline status .*",
                "vra --json pipeline status",
                "vra --json pipeline status .*",
                "vra pipeline plan",
                "vra pipeline plan .*",
                "vra --json pipeline plan",
                "vra --json pipeline plan .*",
                "vra pipeline sync-ledger",
                "vra --json pipeline sync-ledger",
                "git status",
                "git status .*",
                "git diff",
                "git diff .*",
                "git log",
                "git log .*",
                "git show",
                "git show .*",
                "git branch --list",
                "git branch --list .*",
                "git rev-parse",
                "git rev-parse .*",
                "git ls-files",
                "git ls-files .*",
                "git tag -l",
                "git tag -l .*",
                "git add",
                "git add .*",
                "git remote -v",
                "gh pr view",
                "gh pr view .*"
            ],
            "deniedCommands": [
                ".*git push .*--force.*",
                ".*git push -f.*",
                ".*git push .* -f.*",
                ".*git push .*--delete.*",
                ".*git push .*--mirror.*",
                ".*git push .*--prune.*",
                ".*git rebase.*",
                ".*git reset --hard.*",
                ".*git tag .*-d.*",
                ".*git tag .*-f.*",
                ".*git branch .*-D.*",
                ".*git update-ref.*",
                ".*git filter-.*",
                "cdk",
                "cdk .*",
                ".* cdk .*",
                ".*npx .*aws-cdk.*",
                "aws",
                "aws .*",
                ".* aws .*",
                ".*/aws .*",
                ".*uvx .*awscli.*",
                ".*pipx .*aws.*",
                ".*python .*-c .*boto3.*",
                ".*python3 .*-c .*boto3.*",
                ".*python -m vra.*",
                ".*python3 -m vra.*",
                "eval .*",
                ".* eval .*",
                ".*\\$\\(.*",
                ".*`.*",
                ".*vra unlock.*",
                ".*vra iam apply.*",
                ".*vra credential-process.*",
                ".*vra ledger import.*",
                ".*vra ledger upgrade-config .*--write.*",
                ".*vra home migrate.*",
                ".*vra .*--confirm.*",
                ".*vra .*--takeover.*",
                ".*vra .*--allow-replacements.*",
                ".*vra .*--accept-drift.*",
                ".*vra .*--emergency.*",
                ".*vra .*--allow-missing-scanners.*",
                ".*vra .*--writes-stopped.*",
                ".*vra .*--abort-workflow-executions.*",
                ".*vra .*--include-auth-tables.*",
                ".*vra .*--human-approval.*",
                ".*vra .*--force.*"
            ]
        },
        "read": {
            "deniedPaths": ["~/.aws/**", "**/.env", "**/.env.*", "~/.cache/vra/**/owner-tokens/**"]
        },
        "write": {
            "allowedPaths": ["~/.cache/vra/**/repo/**"],
            "deniedPaths": [
                "~/.aws/**",
                "**/.env",
                "**/.env.*",
                "~/.cache/vra/**/owner-tokens/**",
                "**/ledger/approvals/**",
                "**/vra-home.yaml",
                "**/state/history/**",
                "**/state/locks/**",
                "**/state/approvals-consumed/**",
                "**/state/runs/*/state.json",
                "**/state/iam/**",
                "**/state/pipeline/**",
                "**/ledger/envs/*/overlay/**",
                "**/envs/*/overlay/**"
            ]
        },
        "subagent": {
            "availableAgents": ["vra-conflict-resolver", "vra-failure-triager", "vra-reporter"],
            "trustedAgents": ["vra-failure-triager", "vra-reporter"]
        }
    },
    "resources": [
        "file://skill/SKILL.md",
        "file://skill/workflows/*.md",
        "file://adapters/kiro/.kiro/steering/*.md"
    ],
    "hooks": [
        {
            "name": "preToolUse-0",
            "trigger": "preToolUse",
            "matcher": "execute_bash",
            "action": {
                "type": "command",
                "command": "python3 \"${VRA_PACKAGE:-.}/adapters/shared/vra-guard.py\" || exit 2"
            },
            "timeout": 10
        },
        {
            "name": "preToolUse-1",
            "trigger": "preToolUse",
            "matcher": "shell",
            "action": {
                "type": "command",
                "command": "python3 \"${VRA_PACKAGE:-.}/adapters/shared/vra-guard.py\" || exit 2"
            },
            "timeout": 10
        }
    ],
