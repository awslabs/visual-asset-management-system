{
    "env": {
        "VRA_AGENT": "1"
    },
    "enabledMcpjsonServers": ["vra"],
    "permissions": {
        "additionalDirectories": ["~/.cache/vra"],
        "allow": [
            "mcp__vra__status",
            "mcp__vra__report",
            "mcp__vra__ledger_validate",
            "mcp__vra__ledger_show",
            "mcp__vra__ledger_diff",
            "mcp__vra__ledger_graph",
            "mcp__vra__preflight",
            "mcp__vra__sync_dry_run",
            "mcp__vra__history_verify",
            "mcp__vra__history_show",
            "mcp__vra__home_show",
            "mcp__vra__iam_verify",
            "mcp__vra__sync",
            "mcp__vra__merge",
            "mcp__vra__merge_continue",
            "mcp__vra__build",
            "mcp__vra__test",
            "mcp__vra__backup",
            "mcp__vra__resume",
            "mcp__vra__watch",
            "mcp__vra__iam_plan",
            "mcp__vra__pipeline_status",
            "mcp__vra__pipeline_plan",
            "mcp__vra__pipeline_sync_ledger",
            "Bash(vra status:*)",
            "Bash(vra report:*)",
            "Bash(vra ledger validate:*)",
            "Bash(vra ledger show:*)",
            "Bash(vra ledger diff:*)",
            "Bash(vra ledger graph:*)",
            "Bash(vra preflight:*)",
            "Bash(vra iam verify:*)",
            "Bash(vra history:*)",
            "Bash(vra home show:*)",
            "Bash(vra pipeline status:*)",
            "Bash(vra pipeline plan:*)",
            "Bash(vra pipeline sync-ledger:*)",
            "Bash(vra --json status:*)",
            "Bash(vra --json report:*)",
            "Bash(vra --json ledger:*)",
            "Bash(vra --json history:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch --list:*)",
            "Bash(git remote -v)",
            "Bash(git rev-parse:*)",
            "Bash(git ls-files:*)",
            "Bash(git tag -l:*)",
            "Bash(git add:*)",
            "Bash(gh pr view:*)",
            "Edit(~/.cache/vra/**/repo/**)",
            "Read",
            "Grep",
            "Glob"
        ],
        "ask": [
            "mcp__vra__deploy",
            "mcp__vra__promote",
            "mcp__vra__rollback",
            "mcp__vra__restore",
            "mcp__vra__reindex",
            "mcp__vra__data_copy",
            "mcp__vra__migrate",
            "mcp__vra__pipeline_deploy",
            "mcp__vra__pipeline_push_source",
            "Bash(vra setup:*)",
            "Bash(vra --json setup:*)",
            "Bash(vra sync:*)",
            "Bash(vra merge:*)",
            "Bash(vra build:*)",
            "Bash(vra test:*)",
            "Bash(vra backup:*)",
            "Bash(vra watch:*)",
            "Bash(vra iam plan:*)",
            "Bash(vra resume:*)",
            "Bash(vra home sync:*)",
            "Bash(vra deploy:*)",
            "Bash(vra promote:*)",
            "Bash(vra rollback:*)",
            "Bash(vra restore:*)",
            "Bash(vra reindex:*)",
            "Bash(vra migrate:*)",
            "Bash(vra data-copy:*)",
            "Bash(vra ledger upgrade-config:*)",
            "Bash(vra --json deploy:*)",
            "Bash(vra --json promote:*)",
            "Bash(vra --json rollback:*)",
            "Bash(vra --json restore:*)",
            "Bash(vra --json reindex:*)",
            "Bash(vra --json data-copy:*)",
            "Bash(vra pipeline deploy:*)",
            "Bash(vra pipeline push-source:*)",
            "Bash(vra pipeline sync-ledger --deploy:*)",
            "Bash(vra pipeline sync-ledger * --deploy*)",
            "Bash(vra --json pipeline deploy:*)",
            "Bash(vra --json pipeline push-source:*)",
            "Bash(git push:*)",
            "Bash(git remote add:*)",
            "Edit"
        ],
        "deny": [
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push --force-with-lease:*)",
            "Bash(git push * --force*)",
            "Bash(git push * -f *)",
            "Bash(git push --delete:*)",
            "Bash(git push --mirror:*)",
            "Bash(git rebase:*)",
            "Bash(git reset --hard:*)",
            "Bash(git tag -d:*)",
            "Bash(git tag -f:*)",
            "Bash(git branch -D:*)",
            "Bash(git update-ref:*)",
            "Bash(cdk:*)",
            "Bash(npx cdk:*)",
            "Bash(npx aws-cdk:*)",
            "Bash(aws:*)",
            "Bash(uvx awscli:*)",
            "Bash(eval:*)",
            "Bash(vra * --confirm*)",
            "Bash(vra * --takeover*)",
            "Bash(vra * --allow-replacements*)",
            "Bash(vra * --accept-drift*)",
            "Bash(vra * --emergency*)",
            "Bash(vra * --allow-missing-scanners*)",
            "Bash(vra * --writes-stopped*)",
            "Bash(vra * --abort-workflow-executions*)",
            "Bash(vra * --include-auth-tables*)",
            "Bash(vra * --human-approval*)",
            "Bash(vra * --force*)",
            "Bash(vra unlock:*)",
            "Bash(vra iam apply:*)",
            "Bash(vra ledger import:*)",
            "Bash(vra ledger upgrade-config * --write*)",
            "Bash(vra home migrate:*)",
            "Bash(vra credential-process:*)",
            "Bash(python -m vra:*)",
            "Bash(python3 -m vra:*)",
            "Edit(**/ledger/approvals/**)",
            "Edit(**/vra-home.yaml)",
            "Edit(**/state/history/**)",
            "Edit(**/state/locks/**)",
            "Edit(**/state/approvals-consumed/**)",
            "Edit(**/state/runs/*/state.json)",
            "Edit(**/state/iam/**)",
            "Edit(**/state/pipeline/**)",
            "Edit(**/ledger/envs/*/overlay/**)",
            "Edit(**/envs/*/overlay/**)",
            "Edit(~/.cache/vra/**/owner-tokens/**)",
            "Read(~/.cache/vra/**/owner-tokens/**)",
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(~/.aws/**)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/adapters/shared/vra-guard.py || exit 2"
                    }
                ]
            }
        ]
    }
}
