{
    "name": "vra-pipeline",
    "version": "0.5.1",
    "private": true,
    "description": "Optional CodePipeline / CodeBuild lane for vams-release-automation (wraps the vra CLI)",
    "license": "Apache-2.0",
    "bin": {
        "vra-pipeline": "bin/app.js"
    },
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=11.10.0"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "jest --ci",
        "synth": "cdk synth",
        "diff": "cdk diff",
        "deploy": "cdk deploy --all"
    },
    "dependencies": {
        "aws-cdk-lib": "2.275.0",
        "cdk-nag": "2.38.2",
        "constructs": "10.8.1",
        "yaml": "2.9.1"
    },
    "devDependencies": {
        "@types/jest": "30.0.0",
        "@types/node": "22.20.5",
        "aws-cdk": "2.1146.1",
        "jest": "30.5.2",
        "ts-jest": "29.4.15",
        "ts-node": "10.9.2",
        "typescript": "5.9.3"
    }
}
