# VAMS MCP server configuration (all optional).
#
# This server stores NO credentials. It reuses your existing vamscli profile
# for the API URL and authentication. Set these up first:
#
#   vamscli setup <api-gateway-url>
#   vamscli auth login -u <user>
#
# Then (optionally) tune the server with the variables below.

# vamscli profile to use (defaults to the active vamscli profile)
# VAMS_PROFILE=default

# Expose create/update tools and tools that issue a credential (default off)
VAMS_ENABLE_WRITES=false

# Expose archive/delete tools (default off; requires VAMS_ENABLE_WRITES=true)
VAMS_ENABLE_DESTRUCTIVE=false

# Pagination tuning
VAMS_MAX_PAGES=20
VAMS_PAGE_SIZE=100

# Tool sets to register, comma-separated: consumer, operator, admin, edh, edh-admin, custom, all
# (default all over stdio, consumer in remote mode)
# VAMS_MCP_TOOLSETS=consumer

# --- Remote mode (a server hosted for MCP clients that connect over HTTP) ---
# stdio (default) or streamable-http. Remote mode reads no vamscli profile: VAMS_PROFILE is refused.
# VAMS_MCP_TRANSPORT=streamable-http
# The auth configuration file `vams-mcp setup-remote` writes (required in remote mode)
# VAMS_MCP_AUTH_CONFIG=/etc/vams-mcp/auth.json
# Listen address and port. Keep 127.0.0.1 unless the server runs in a container or private network
# behind an HTTPS front end.
# VAMS_MCP_HOST=127.0.0.1
# VAMS_MCP_PORT=8000
# Seconds one tool call may take (10 to 1800)
# VAMS_MCP_TOOL_TIMEOUT=240
