{
    "metadata": {
        "name": "Compliance Readonly",
        "description": "Read-only compliance access for one database. Can view the database's and GLOBAL compliance schemas, the database's evaluation state, history, audit log and cascades. Cannot trigger evaluations, modify or bind schemas, or release quarantined assets. Grants no asset pages: evaluation history is on the database compliance overview.",
        "version": "2.0"
    },
    "variables": [
        {
            "name": "DATABASE_ID",
            "required": true,
            "description": "The databaseId to scope compliance permissions to"
        },
        { "name": "ROLE_NAME", "required": true, "description": "The role name to create" }
    ],
    "constraints": [
        {
            "name": "{{ROLE_NAME}}-compliance-web-routes",
            "description": "Allow navigation to compliance pages",
            "objectType": "web",
            "criteriaAnd": [],
            "criteriaOr": [
                { "field": "route__path", "operator": "starts_with", "value": "/compliance" },
                { "field": "route__path", "operator": "starts_with", "value": "/databases" }
            ],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-api-routes-get",
            "description": "Allow read-only API access to compliance endpoints",
            "objectType": "api",
            "criteriaAnd": [],
            "criteriaOr": [
                { "field": "route__path", "operator": "starts_with", "value": "/compliance" },
                { "field": "route__path", "operator": "starts_with", "value": "/secure-config" },
                { "field": "route__path", "operator": "starts_with", "value": "/amplify-config" },
                { "field": "route__path", "operator": "starts_with", "value": "/auth/routes" },
                { "field": "route__path", "operator": "starts_with", "value": "/auth/loginProfile" }
            ],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-api-routes-post",
            "description": "Allow non-mutating POST API access (sign-in profile and route listing)",
            "objectType": "api",
            "criteriaAnd": [],
            "criteriaOr": [
                { "field": "route__path", "operator": "starts_with", "value": "/auth/routes" },
                { "field": "route__path", "operator": "starts_with", "value": "/auth/loginProfile" }
            ],
            "groupPermissions": [{ "action": "POST", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-database-list-route",
            "description": "Allow the database list route only (exact path), so the Databases page lists {{DATABASE_ID}} and links to its compliance page",
            "objectType": "api",
            "criteriaAnd": [],
            "criteriaOr": [{ "field": "route__path", "operator": "equals", "value": "/database" }],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-schemas-readonly",
            "description": "Allow read of the database's compliance schemas",
            "objectType": "complianceSchema",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-schemas-global-readonly",
            "description": "Allow read of GLOBAL compliance schemas",
            "objectType": "complianceSchema",
            "criteriaAnd": [{ "field": "databaseId", "operator": "equals", "value": "GLOBAL" }],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-evaluations-readonly",
            "description": "Allow viewing compliance evaluations in {{DATABASE_ID}}",
            "objectType": "complianceEvaluation",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-cascades-readonly",
            "description": "Allow read of the database's compliance cascades",
            "objectType": "complianceCascade",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-assets-readonly",
            "description": "Allow read access to assets in {{DATABASE_ID}} for compliance viewing",
            "objectType": "asset",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-database-readonly",
            "description": "Allow read access to the {{DATABASE_ID}} database entity",
            "objectType": "database",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        }
    ]
}
