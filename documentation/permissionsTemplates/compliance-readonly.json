{
    "metadata": {
        "name": "Compliance Readonly",
        "description": "Read-only access for FMM compliance operations. Can view compliance schemas, evaluation state, audit logs, and cascade status. Cannot trigger evaluations, modify schemas, or release quarantined assets.",
        "version": "1.0"
    },
    "variables": [
        {
            "name": "DATABASE_ID",
            "required": true,
            "description": "The databaseId to scope compliance permissions to"
        },
        { "name": "ROLE_NAME", "required": true, "description": "The role name to create" }
    ],
    "constraints": [
        {
            "name": "{{ROLE_NAME}}-compliance-web-routes",
            "description": "Allow navigation to compliance pages",
            "objectType": "web",
            "criteriaAnd": [],
            "criteriaOr": [
                { "field": "route__path", "operator": "starts_with", "value": "/compliance" },
                { "field": "route__path", "operator": "starts_with", "value": "/databases" }
            ],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-api-routes",
            "description": "Allow read-only API access to compliance endpoints",
            "objectType": "api",
            "criteriaAnd": [],
            "criteriaOr": [
                { "field": "route__path", "operator": "starts_with", "value": "/compliance" },
                { "field": "route__path", "operator": "starts_with", "value": "/secure-config" },
                { "field": "route__path", "operator": "starts_with", "value": "/amplify-config" },
                { "field": "route__path", "operator": "starts_with", "value": "/auth/routes" }
            ],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-schemas-readonly",
            "description": "Allow viewing compliance schemas",
            "objectType": "complianceSchema",
            "criteriaAnd": [],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-evaluations-readonly",
            "description": "Allow viewing compliance evaluations in {{DATABASE_ID}}",
            "objectType": "complianceEvaluation",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-compliance-cascades-readonly",
            "description": "Allow viewing cascade operations",
            "objectType": "complianceCascade",
            "criteriaAnd": [],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-assets-readonly",
            "description": "Allow read access to assets in {{DATABASE_ID}} for compliance viewing",
            "objectType": "asset",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        },
        {
            "name": "{{ROLE_NAME}}-database-readonly",
            "description": "Allow read access to the {{DATABASE_ID}} database entity",
            "objectType": "database",
            "criteriaAnd": [
                { "field": "databaseId", "operator": "equals", "value": "{{DATABASE_ID}}" }
            ],
            "criteriaOr": [],
            "groupPermissions": [{ "action": "GET", "type": "allow" }]
        }
    ]
}
