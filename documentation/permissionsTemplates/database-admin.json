{
    "metadata": {
        "name": "Database Admin",
        "description": "Administrative access for a specific database. Can create, update and delete (archive) the database and view its archived record, full CRUD on assets (including permanent delete) and on the database's archived assets (view, unarchive, permanent delete), create/delete pipelines/workflows/metadata schemas, execute workflows, and ingest assets. Can view and execute global pipelines and workflows. Administers the database's compliance: its schemas (GLOBAL schemas read-only), bindings, evaluations, quarantine and exceptions, and cascade approval.",
        "version": "1.0"
    },
    "variables": [
        {
            "name": "DATABASE_ID",
            "required": true,
            "description": "The databaseId to scope permissions to"
        },
        {
            "name": "ROLE_NAME",
            "required": true,
            "description": "The existing role to attach these constraints to"
        }
    ],
    "constraints": [
        {
            "name": "{{ROLE_NAME}}-user-api-keys",
            "description": "Allow self-service API key management (own keys only, expiration required)",
            "objectType": "api",
            "criteriaAnd": [
                {
                    "field": "route__path",
                    "operator": "starts_with",
                    "value": "/auth/user/api-keys"
                }
            ],
            "criteriaOr": [],
            "groupPermissions": [
                {
                    "action": "GET",
                    "type": "allow"
                },
                {
                    "action": "POST",
                    "type": "allow"
                },
                {
                    "action": "PUT",
                    "type": "allow"
                },
                {
                    "action": "DELETE",
                    "type": "allow"
                }
            ]
        },
