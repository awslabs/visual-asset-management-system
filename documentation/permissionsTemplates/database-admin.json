            "name": "{{ROLE_NAME}}-database",
            "description": "Allow read, create, update and delete (archive) of {{DATABASE_ID}} and read of its archived record (creating it again restores it). Names both ids: an archived record must match both.",
            "objectType": "database",
            "criteriaAnd": [],
