        <mxCell id="priv" value="Private subnet (optional)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=1;strokeColor=#147EBA;fillColor=#E6F2F8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="675" width="390" height="215" as="geometry" /></mxCell>
        <mxCell id="pub" value="Public subnet&lt;br&gt;(optional)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=1;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=1;" vertex="1" parent="1"><mxGeometry x="735" y="675" width="135" height="215" as="geometry" /></mxCell>
        <mxCell id="zaddfn" value="EDH Workstations add-on (new)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fontSize=12;fillColor=#FFF4E6;strokeColor=#D86613;strokeWidth=2;dashed=0;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontColor=#D86613;" vertex="1" parent="1"><mxGeometry x="460" y="255" width="395" height="385" as="geometry" /></mxCell>
        <mxCell id="sgfn" value="Add-on security group" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=#DD344C;dashed=0;align=left;spacingLeft=8;fontColor=#DD344C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="200" height="145" as="geometry" /></mxCell>
        <mxCell id="zaddep" value="Add-on endpoints (optional)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=#D86613;dashed=1;align=left;spacingLeft=8;fontStyle=1;fontColor=#D86613;fontSize=11;verticalAlign=bottom;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="480" y="465" width="360" height="160" as="geometry" /></mxCell>
        <mxCell id="zaddami" value="Add-on AMI builds (optional)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fontSize=12;fillColor=#FFF4E6;strokeColor=#D86613;strokeWidth=2;dashed=0;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontColor=#D86613;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="712" width="225" height="158" as="geometry" /></mxCell>
        <mxCell id="zedh" value="EDH cluster (existing, operator-deployed)" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fontSize=12;fillColor=#F7F2FF;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;align=left;spacingLeft=8;spacingTop=2;fontStyle=1;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="945" y="160" width="295" height="765" as="geometry" /></mxCell>
        <mxCell id="edhvpc" value="EDH cluster VPC&lt;br&gt;(VAMS VPC or connected VPC)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#248814;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="210" width="265" height="700" as="geometry" /></mxCell>
        <mxCell id="sgalb" value="ALB security group" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=#DD344C;dashed=0;align=left;spacingLeft=8;fontColor=#DD344C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="280" width="205" height="135" as="geometry" /></mxCell>
        <mxCell id="edhpriv" value="Private subnets" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1"><mxGeometry x="975" y="550" width="240" height="350" as="geometry" /></mxCell>
        <mxCell id="sgdesk" value="Desktop security group" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=#DD344C;dashed=0;align=left;spacingLeft=8;fontColor=#DD344C;fontSize=11;verticalAlign=bottom;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="983" y="735" width="200" height="155" as="geometry" /></mxCell>
        <mxCell id="panel" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;dashed=1;dashPattern=1 2;" vertex="1" parent="1"><mxGeometry x="1290" y="140" width="540" height="616" as="geometry" /></mxCell>
        <mxCell id="ptext1" value="The add-on &lt;b&gt;AWS Lambda&lt;/b&gt; functions run in the VAMS VPC&amp;#39;s isolated subnets behind one add-on security group, which has no ingress rules and allows egress only on HTTPS 443 and the EDH API port." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="166" width="470" height="48" as="geometry" /></mxCell>
        <mxCell id="pbadge1" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="177.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext2" value="The &lt;b&gt;AWS Lambda&lt;/b&gt; functions call the EDH &lt;b&gt;AWS Application Load Balancer&lt;/b&gt; through VPC routing: EDH shares the VAMS VPC, or the operator connects the two VPCs with &lt;b&gt;Amazon VPC peering&lt;/b&gt; or &lt;b&gt;AWS Transit Gateway&lt;/b&gt;. The operator allows the add-on security group on the load balancer&amp;#39;s security group." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="226" width="470" height="64" as="geometry" /></mxCell>
        <mxCell id="pbadge2" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="245.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext3" value="The common VAMS &lt;b&gt;Amazon VPC&lt;/b&gt; endpoints carry calls to &lt;b&gt;AWS Secrets Manager&lt;/b&gt;, &lt;b&gt;AWS Lambda&lt;/b&gt;, &lt;b&gt;AWS Systems Manager&lt;/b&gt; and &lt;b&gt;Amazon CloudWatch Logs&lt;/b&gt;, and the gateway endpoints carry &lt;b&gt;Amazon DynamoDB&lt;/b&gt; and &lt;b&gt;Amazon S3&lt;/b&gt; traffic. In a VPC without VAMS endpoints, the operator&amp;#39;s VPC provides these paths." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="302" width="470" height="64" as="geometry" /></mxCell>
        <mxCell id="pbadge3" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="321.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext4" value="The VAMS VPC stack adds an &lt;b&gt;Amazon VPC&lt;/b&gt; endpoint to &lt;b&gt;AWS Batch&lt;/b&gt; for container job definitions, and &lt;b&gt;Amazon EC2 Image Builder&lt;/b&gt;, &lt;b&gt;Amazon EC2&lt;/b&gt; and &lt;b&gt;AWS Systems Manager&lt;/b&gt; messaging endpoints for AMI builds. Container images build in &lt;b&gt;AWS CodeBuild&lt;/b&gt; outside the VPC, so no &lt;b&gt;Amazon ECR&lt;/b&gt; endpoint is needed." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="378" width="470" height="64" as="geometry" /></mxCell>
        <mxCell id="pbadge4" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="397.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext5" value="The &lt;b&gt;Amazon EC2&lt;/b&gt; build instance launches in the configured build subnet, else a private subnet, else an isolated subnet, with no ingress and egress only on ports 443 and 80. &lt;b&gt;Amazon EC2 Image Builder&lt;/b&gt; drives it through the &lt;b&gt;AWS Systems Manager&lt;/b&gt; agent." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="454" width="470" height="48" as="geometry" /></mxCell>
        <mxCell id="pbadge5" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="465.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext6" value="Recipes that download packages need outbound access through an &lt;b&gt;Amazon VPC NAT gateway&lt;/b&gt;. A VPC that VAMS creates has private and public subnets only when another feature needs them; otherwise set &lt;i&gt;amiBuilds.buildSubnetId&lt;/i&gt; to a subnet with internet egress." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="514" width="470" height="64" as="geometry" /></mxCell>
        <mxCell id="pbadge6" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="533.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext7" value="The browser needs a network path to the &lt;b&gt;Amazon DCV&lt;/b&gt; entry point in the URL EDH returns: by default an &lt;b&gt;AWS Network Load Balancer&lt;/b&gt; fronting the Amazon DCV Connection Gateway, or the EDH &lt;b&gt;AWS Application Load Balancer&lt;/b&gt; in the standard layout. VAMS never proxies it." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="590" width="470" height="64" as="geometry" /></mxCell>
        <mxCell id="pbadge7" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="609.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext8" value="Each desktop is an &lt;b&gt;Amazon EC2&lt;/b&gt; instance that EDH launches from its own &lt;b&gt;AWS CloudFormation&lt;/b&gt; stack into a private subnet, with no public IP. The &lt;b&gt;Amazon DCV Connection Gateway&lt;/b&gt; asks the &lt;b&gt;Amazon DCV Session Manager&lt;/b&gt; broker where a session runs and relays it to that desktop on port 8443." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="666" width="470" height="64" as="geometry" /></mxCell>
        <mxCell id="pbadge8" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1304" y="685.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="legendbox" value="" style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#B0B0B0;" vertex="1" parent="1"><mxGeometry x="1290" y="780" width="540" height="150" as="geometry" /></mxCell>
        <mxCell id="legtitle" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1304" y="788" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="sw1" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="1304" y="816" width="36" height="18" as="geometry" /></mxCell>
        <mxCell id="sw1t" value="&lt;b&gt;AWS VAMS (Existing)&lt;/b&gt;: part of every VAMS deployment" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1352" y="813" width="460" height="24" as="geometry" /></mxCell>
        <mxCell id="sw2" value="" style="rounded=0;html=1;fillColor=#FFF4E6;strokeColor=#D86613;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1304" y="842" width="36" height="18" as="geometry" /></mxCell>
        <mxCell id="sw2t" value="&lt;b&gt;EDH Workstations add-on (new)&lt;/b&gt;: deployed by VAMS for EDH Workstations" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1352" y="839" width="460" height="24" as="geometry" /></mxCell>
        <mxCell id="sw3" value="" style="rounded=0;html=1;fillColor=#F7F2FF;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1304" y="868" width="36" height="18" as="geometry" /></mxCell>
        <mxCell id="sw3t" value="&lt;b&gt;EDH cluster (existing)&lt;/b&gt;: installed and managed by the operator" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1352" y="865" width="460" height="24" as="geometry" /></mxCell>
        <mxCell id="legdash" value="" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1304" y="903" as="sourcePoint" /><mxPoint x="1340" y="903" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legdasht" value="Dashed arrow: Amazon DCV desktop traffic, not through VAMS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1352" y="891" width="460" height="24" as="geometry" /></mxCell>
        <mxCell id="user" value="&lt;b&gt;VAMS User&lt;/b&gt;&lt;br&gt;Web Browser" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="70" y="20" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="sm" value="&lt;b&gt;AWS Secrets Manager&lt;/b&gt;&lt;br&gt;Session Secrets" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="86" y="312" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="ddb" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;EDH Tables" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="86" y="483" width="50" height="50" as="geometry" /></mxCell>
