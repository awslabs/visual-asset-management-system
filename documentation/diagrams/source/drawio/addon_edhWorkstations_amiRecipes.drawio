        <mxCell id="ddbrec" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;AMI Recipe Table" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;labelBackgroundColor=#FFF4E6;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="eb" value="&lt;b&gt;Amazon EventBridge&lt;/b&gt;&lt;br&gt;Build Events &amp; Sweep" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;labelBackgroundColor=#FFF4E6;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="960" y="540" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="imagebuilder" value="&lt;b&gt;Amazon EC2 Image Builder&lt;/b&gt;&lt;br&gt;Image Pipeline" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2_image_builder;labelBackgroundColor=#FFF4E6;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="960" y="655" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="ami" value="&lt;b&gt;Amazon EC2&lt;/b&gt;&lt;br&gt;AMIs &amp; Snapshots" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.ami;labelBackgroundColor=#FFF4E6;" vertex="1" parent="1"><mxGeometry x="1080" y="870" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="edhalb" value="&lt;b&gt;AWS Application&lt;br&gt;Load Balancer&lt;/b&gt;&lt;br&gt;EDH REST API" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;labelBackgroundColor=#F7F2FF;" vertex="1" parent="1"><mxGeometry x="1328" y="405" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="edhdesk" value="&lt;b&gt;Amazon EC2&lt;/b&gt;&lt;br&gt;Amazon DCV Desktops" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;labelBackgroundColor=#F7F2FF;" vertex="1" parent="1"><mxGeometry x="1328" y="950" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="heading" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;EDH AMI Recipe Build Flow&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="700" y="50" width="360" height="40" as="geometry" /></mxCell>
        <mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1130" y="22" width="335" height="128" as="geometry" /></mxCell>
        <mxCell id="legendTitle" value="&lt;b&gt;Ownership&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1140" y="26" width="150" height="20" as="geometry" /></mxCell>
        <mxCell id="legendSw0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;dashPattern=1 2;" vertex="1" parent="1"><mxGeometry x="1140" y="53" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="legendTx0" value="&lt;b&gt;AWS VAMS (Existing)&lt;/b&gt;: part of every VAMS deployment" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1168" y="48" width="292" height="24" as="geometry" /></mxCell>
        <mxCell id="legendSw1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D86613;dashed=0;" vertex="1" parent="1"><mxGeometry x="1140" y="77" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="legendTx1" value="&lt;b&gt;EDH Workstations add-on (new)&lt;/b&gt;: deployed by VAMS for EDH Workstations" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1168" y="72" width="292" height="24" as="geometry" /></mxCell>
        <mxCell id="legendSw2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F2FF;strokeColor=#8C4FFF;dashed=1;" vertex="1" parent="1"><mxGeometry x="1140" y="101" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="legendTx2" value="&lt;b&gt;EDH cluster (existing)&lt;/b&gt;: installed and managed by the operator" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1168" y="96" width="292" height="24" as="geometry" /></mxCell>
        <mxCell id="legendSw3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1140" y="125" width="22" height="14" as="geometry" /></mxCell>
        <mxCell id="legendTx3" value="&lt;b&gt;No zone&lt;/b&gt;: AWS-managed public input" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1168" y="120" width="292" height="24" as="geometry" /></mxCell>
        <mxCell id="badge1" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="218" y="42" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="badge2" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="465" y="42" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="badge3" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="468" y="508" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="badge4" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="578" y="848" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="badge5" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="225" y="882" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="badge6" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1003" y="518" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="badge7" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1136" y="848" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="badge8" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1386" y="418" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext1" value="At deployment, &lt;b&gt;AWS CloudFormation&lt;/b&gt; uploads the recipe bundles to the existing artefacts &lt;b&gt;Amazon S3&lt;/b&gt; bucket. The Catalog Registration &lt;b&gt;AWS Lambda&lt;/b&gt; function reads them, stores each recipe in &lt;b&gt;Amazon DynamoDB&lt;/b&gt; and builds changed recipes marked to build on deploy." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="184" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge1" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="202.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext2" value="An administrator manages and builds recipes from the AMI Recipes page or vamscli through new routes on &lt;b&gt;Amazon API Gateway&lt;/b&gt;. The AMI Recipe API &lt;b&gt;AWS Lambda&lt;/b&gt; function runs one build per recipe at a time and queues further requests." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="299" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge2" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="317.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext3" value="To start a build, the AMI Recipe API function resolves the parent image, for example from an &lt;b&gt;AWS Systems Manager&lt;/b&gt; public parameter, and creates the recipe&amp;#39;s &lt;b&gt;Amazon EC2 Image Builder&lt;/b&gt; pipeline. When the VAMS VPC uses &lt;b&gt;Amazon VPC&lt;/b&gt; endpoints, the add-on adds the ones the build needs." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="414" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge3" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="432.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext4" value="&lt;b&gt;Amazon EC2 Image Builder&lt;/b&gt; launches an &lt;b&gt;Amazon EC2&lt;/b&gt; build instance in the build subnet, a private subnet by default. Its security group allows no inbound traffic, and Image Builder drives the instance through &lt;b&gt;AWS Systems Manager&lt;/b&gt;." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="529" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge4" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="547.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext5" value="The build copies the recipe&amp;#39;s files from the artefacts &lt;b&gt;Amazon S3&lt;/b&gt; bucket and downloads packages through an &lt;b&gt;Amazon VPC NAT gateway&lt;/b&gt; and an &lt;b&gt;Amazon VPC internet gateway&lt;/b&gt; in the VAMS VPC, so the build subnet needs outbound internet access." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="644" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge5" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="662.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext6" value="An &lt;b&gt;Amazon EventBridge&lt;/b&gt; rule passes &lt;b&gt;Amazon EC2 Image Builder&lt;/b&gt; state changes to the Build Registrar &lt;b&gt;AWS Lambda&lt;/b&gt; function, and a 30-minute schedule invokes it to finish missed builds, retry registrations and start queued builds." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="759" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge6" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="777.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext7" value="Each AMI and its &lt;b&gt;Amazon EBS&lt;/b&gt; snapshots carry a visibility tag that tells EDH which cluster may offer the image. The registrar keeps the newest versions of each recipe and removes older retired or failed builds once no Amazon EC2 instance uses their AMI." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="874" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge7" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="892.5" width="25" height="25" as="geometry" /></mxCell>
        <mxCell id="ptext8" value="The registrar registers each build in the configured &lt;b&gt;EDH&lt;/b&gt; project as a versioned software stack, which EDH launches &lt;b&gt;Amazon EC2&lt;/b&gt; desktops from. An administrator can retry a failed registration or retire a build through the AMI Recipe API." style="text;whiteSpace=wrap;html=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1540" y="989" width="404" height="62" as="geometry" /></mxCell>
        <mxCell id="pbadge8" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#3D7FC4;" vertex="1" parent="1"><mxGeometry x="1504" y="1007.5" width="25" height="25" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
