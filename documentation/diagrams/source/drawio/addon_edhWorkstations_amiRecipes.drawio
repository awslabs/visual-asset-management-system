        <mxCell id="buildinst" value="&lt;b&gt;Amazon EC2&lt;/b&gt;&lt;br&gt;Build Instance" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;labelBackgroundColor=#FFF4E6;" vertex="1" parent="1"><mxGeometry x="517" y="870" width="50" height="50" as="geometry" /></mxCell>
        <mxCell id="nat" value="Amazon VPC&lt;br&gt;NAT Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;labelBackgroundColor=#F2F6E8;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="273" y="878" width="34" height="34" as="geometry" /></mxCell>
