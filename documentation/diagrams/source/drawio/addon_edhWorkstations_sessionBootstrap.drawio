ight="25" as="geometry"/></mxCell><mxCell id="b4" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="1"><mxGeometry x="1039" y="160" width="25" height="25" as="geometry"/></mxCell><mxCell id="b5" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="1"><mxGeometry x="768" y="321" width="25" height="25" as="geometry"/></mxCell><mxCell id="b6" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="1"><mxGeometry x="937" y="578" width="25" height="25" as="geometry"/></mxCell><mxCell id="b7" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="1"><mxGeometry x="1257" y="578" width="25" height="25" as="geometry"/></mxCell><mxCell id="b8" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="1"><mxGeometry x="569" y="520" width="25" height="25" as="geometry"/></mxCell><mxCell id="lg-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="600" width="200" height="20" as="geometry"/></mxCell><mxCell id="lg-vams" value="" style="rounded=0;fillColor=none;strokeColor=#000000;dashed=1;dashPattern=1 2;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#000000;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="636" width="28" height="20" as="geometry"/></mxCell><mxCell id="lg-vams-t" value="&lt;b&gt;AWS VAMS (Existing)&lt;/b&gt;: part of every VAMS deployment" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="176" y="628" width="180" height="36" as="geometry"/></mxCell><mxCell id="lg-addon" value="" style="rounded=0;fillColor=#FFF4E6;strokeColor=#D86613;strokeWidth=1.5;dashed=0;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#D86613;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="694" width="28" height="20" as="geometry"/></mxCell><mxCell id="lg-addon-t" value="&lt;b&gt;EDH Workstations add-on (new)&lt;/b&gt;: deployed by VAMS for EDH Workstations" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="176" y="686" width="180" height="36" as="geometry"/></mxCell><mxCell id="lg-edh" value="" style="rounded=0;fillColor=none;strokeColor=#8C4FFF;strokeWidth=1.5;dashed=1;verticalAlign=top;align=center;spacingTop=4;fontStyle=1;fontColor=#8C4FFF;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="752" width="28" height="20" as="geometry"/></mxCell><mxCell id="lg-edh-t" value="&lt;b&gt;EDH cluster (existing)&lt;/b&gt;: installed and managed by the operator" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="176" y="744" width="180" height="36" as="geometry"/></mxCell><mxCell id="panel" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;dashed=1;dashPattern=1 2;" vertex="1" parent="1"><mxGeometry x="1380" y="40" width="400" height="775" as="geometry"/></mxCell><mxCell id="p1" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="58" width="380" height="67.6" as="geometry"/></mxCell><mxCell id="p1-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p1"><mxGeometry x="0" y="21.3" width="25" height="25" as="geometry"/></mxCell><mxCell id="p1-text" value="A user launches a workstation. The existing &lt;b&gt;Amazon API Gateway&lt;/b&gt; routes the request to the add-on's Workstation API &lt;b&gt;AWS Lambda&lt;/b&gt; function, which records the session in the &lt;b&gt;Amazon DynamoDB&lt;/b&gt; session table." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p1"><mxGeometry x="34" y="0" width="346" height="67.6" as="geometry"/></mxCell><mxCell id="p2" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="160.09" width="380" height="53.2" as="geometry"/></mxCell><mxCell id="p2-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p2"><mxGeometry x="0" y="14.1" width="25" height="25" as="geometry"/></mxCell><mxCell id="p2-text" value="The Workstation API mints a short-lived VAMS API key for the launching user through the existing API Key Service &lt;b&gt;AWS Lambda&lt;/b&gt; function." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p2"><mxGeometry x="34" y="0" width="346" height="53.2" as="geometry"/></mxCell><mxCell id="p3" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="247.77" width="380" height="67.6" as="geometry"/></mxCell><mxCell id="p3-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p3"><mxGeometry x="0" y="21.3" width="25" height="25" as="geometry"/></mxCell><mxCell id="p3-text" value="It stores the key and the VAMS web URL in a per-session &lt;b&gt;AWS Secrets Manager&lt;/b&gt; secret, encrypted with the add-on's &lt;b&gt;AWS KMS&lt;/b&gt; key and unreadable until bound. Without a custom domain, the URL comes from &lt;b&gt;AWS Systems Manager&lt;/b&gt; Parameter Store." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p3"><mxGeometry x="34" y="0" width="346" height="67.6" as="geometry"/></mxCell><mxCell id="p4" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="349.86" width="380" height="82" as="geometry"/></mxCell><mxCell id="p4-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p4"><mxGeometry x="0" y="28.5" width="25" height="25" as="geometry"/></mxCell><mxCell id="p4-text" value="The Launch Worker &lt;b&gt;AWS Lambda&lt;/b&gt; function asks the EDH REST API behind the EDH &lt;b&gt;AWS Application Load Balancer&lt;/b&gt; for a desktop. EDH launches an &lt;b&gt;Amazon EC2&lt;/b&gt; instance from a per-desktop &lt;b&gt;AWS CloudFormation&lt;/b&gt; stack and tags it with the session name VAMS chose." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p4"><mxGeometry x="34" y="0" width="346" height="82" as="geometry"/></mxCell><mxCell id="p5" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="466.34" width="380" height="53.2" as="geometry"/></mxCell><mxCell id="p5-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p5"><mxGeometry x="0" y="14.1" width="25" height="25" as="geometry"/></mxCell><mxCell id="p5-text" value="Once EDH reports the desktop's &lt;b&gt;Amazon EC2&lt;/b&gt; instance, VAMS binds the secret with a resource policy: only the EDH instance role can read it, and only from that instance." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p5"><mxGeometry x="34" y="0" width="346" height="53.2" as="geometry"/></mxCell><mxCell id="p6" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="554.03" width="380" height="53.2" as="geometry"/></mxCell><mxCell id="p6-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p6"><mxGeometry x="0" y="14.1" width="25" height="25" as="geometry"/></mxCell><mxCell id="p6-text" value="Each time the desktop session starts, a sign-in script from the add-on's AMI recipe finds the secret by the instance's session-name tag and reads it with the instance role." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p6"><mxGeometry x="34" y="0" width="346" height="53.2" as="geometry"/></mxCell><mxCell id="p7" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="641.71" width="380" height="53.2" as="geometry"/></mxCell><mxCell id="p7-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p7"><mxGeometry x="0" y="14.1" width="25" height="25" as="geometry"/></mxCell><mxCell id="p7-text" value="The script signs vamscli in under this desktop's edh-&amp;lt;id&amp;gt; profile and the edh alias, so tools on the desktop call the VAMS API as the launching user without a second sign-in." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p7"><mxGeometry x="34" y="0" width="346" height="53.2" as="geometry"/></mxCell><mxCell id="p8" value="" style="group" vertex="1" parent="1" connectable="0"><mxGeometry x="1390" y="729.4" width="380" height="67.6" as="geometry"/></mxCell><mxCell id="p8-badge" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" vertex="1" parent="p8"><mxGeometry x="0" y="21.3" width="25" height="25" as="geometry"/></mxCell><mxCell id="p8-text" value="Stopping a workstation revokes its key and marks the secret revoked; deleting it removes both. Every 15 minutes an &lt;b&gt;Amazon EventBridge&lt;/b&gt; schedule runs the Session Reconciler, which revokes stale keys and binds late secrets." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;" vertex="1" parent="p8"><mxGeometry x="34" y="0" width="346" height="67.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
