        <mxCell id="norender" value="AWS Step Functions&lt;br&gt;No Render" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="825" y="765" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gm" value="AWS Lambda&lt;br&gt;Attributes and Analysis" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="575" y="890" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="choice" value="Vector search on and&lt;br&gt;analysis succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#CD2264;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="515" y="985" width="170" height="76" as="geometry" />
        </mxCell>
        <mxCell id="ge" value="AWS Lambda&lt;br&gt;Embedding" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="575" y="1100" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="window" value="AWS Lambda&lt;br&gt;Window Analyzer" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="365" y="1245" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pe" value="AWS Lambda&lt;br&gt;Pipeline End" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="575" y="1385" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value="Amazon ECR&lt;br&gt;Container Images" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="765" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="analysis" value="Amazon Bedrock&lt;br&gt;Analysis Model" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="890" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="guardrail" value="Amazon Bedrock Guardrails&lt;br&gt;Prompt-Attack and&lt;br&gt;PII Filters" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="1085" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="embeddings" value="Amazon Bedrock&lt;br&gt;Embeddings Model" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;gradientDirection=north;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="100" y="1230" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="938" y="158" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="552" y="342" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="552" y="582" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="258" y="690" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1068" y="787" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="552" y="882" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="8" y="853" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="552" y="1092" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="273" y="1188" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1150" y="1048" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="552" y="1377" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;dashed=1;dashPattern=1 2;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1370" y="130" width="610" height="1119" as="geometry" />
        </mxCell>
        <mxCell id="panel-b1" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="192.5" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t1" value="The existing &lt;b&gt;AWS Visual Asset Management System (VAMS)&lt;/b&gt; solution stores the files in the &lt;b&gt;Amazon S3&lt;/b&gt; asset bucket, runs workflows on &lt;b&gt;AWS Step Functions&lt;/b&gt;, keeps metadata and attributes in &lt;b&gt;Amazon DynamoDB&lt;/b&gt;, holds pipeline working data in the &lt;b&gt;Amazon S3&lt;/b&gt; auxiliary bucket and carries events on the &lt;b&gt;Amazon EventBridge&lt;/b&gt; orchestration bus. The vector embeddings table exists in every deployment; its vector index is created only when vector search is enabled." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="156" width="534" height="98" as="geometry" />
        </mxCell>
        <mxCell id="panel-b2" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="299" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t2" value="A new version of a file in the asset bucket fires the file-upload trigger, and the VAMS workflow runs the SYSTEM GenAI metadata pipeline on that one file. An &lt;b&gt;AWS Lambda&lt;/b&gt; function resolves the input from the execution manifest; a second one checks the extension, starts the pipeline's &lt;b&gt;AWS Step Functions&lt;/b&gt; state machine and registers the sub-execution with VAMS." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="270" width="534" height="83" as="geometry" />
        </mxCell>
        <mxCell id="panel-b3" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="375.5" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t3" value="The first step classifies the file into a file class, applies the size gates and chooses its render branch." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="369" width="534" height="38" as="geometry" />
        </mxCell>
        <mxCell id="panel-b4" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="474.5" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t4" value="Each branch downloads the file, with the files a 3D scene references, and extracts its attributes. The Blender renderer, the 3D renderer and the media extractor are &lt;b&gt;AWS Lambda&lt;/b&gt; functions built from container images in &lt;b&gt;Amazon ECR&lt;/b&gt;; a USD scene that Blender cannot render falls back to the 3D renderer. With &lt;code&gt;useFargateRenderer&lt;/code&gt;, which requires the VPC, files over the Lambda limits and scenes whose referenced files exceed the Lambda budget render as an &lt;b&gt;AWS Batch&lt;/b&gt; job on &lt;b&gt;AWS Fargate&lt;/b&gt;. Proprietary CAD formats are not rendered and are described from their name and the asset's metadata. A render fault continues without views and never fails the execution." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="423" width="534" height="128" as="geometry" />
        </mxCell>
        <mxCell id="panel-b5" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="581" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t5" value="The branches write the rendered views, keyframes and page images and the analysis manifest to the &lt;b&gt;Amazon S3&lt;/b&gt; auxiliary bucket, from which the analysis step reads them. With the GenAI layer (&lt;code&gt;useGenAiAnalysis&lt;/code&gt;) off, nothing is rendered." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="567" width="534" height="53" as="geometry" />
        </mxCell>
        <mxCell id="panel-b6" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="672.5" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t6" value="The analysis step writes the file's &lt;code&gt;sys_*&lt;/code&gt; attributes, the promoted &lt;code&gt;ext_*&lt;/code&gt; metadata and, when the file carries a position, a GeoJSON location first. It then sends the renders, the text excerpt, the attributes and, with &lt;code&gt;SEED_WITH_EXISTING_METADATA&lt;/code&gt;, the existing metadata to the analysis model, and writes the generated &lt;code&gt;genai_*&lt;/code&gt; metadata for the file, the asset or both. The attribute and metadata files go to the execution's output prefix in the asset bucket. With the GenAI layer off, no model is called." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="636" width="534" height="98" as="geometry" />
        </mxCell>
        <mxCell id="panel-b7" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="794" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t7" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt; serves every model the pipeline calls, each named in the &lt;code&gt;bedrockModels&lt;/code&gt; configuration block: the analysis model (and an optional text model for requests without images) through the Converse API, and the embeddings model through InvokeModel. The &lt;b&gt;Amazon Bedrock Guardrails&lt;/b&gt; guardrail, with its prompt-attack and PII filters, is required whenever the pipeline calls Amazon Bedrock. It is attached to every Converse call, and the embedding steps screen their text with ApplyGuardrail, because an embeddings call carries no guardrail of its own." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="750" width="534" height="113" as="geometry" />
        </mxCell>
        <mxCell id="panel-b8" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="915.5" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t8" value="When vector search is enabled and the analysis succeeded, the embedding step composes the file's embedding text, screens it with the guardrail, embeds it with the embeddings model, writes the embedding document to the auxiliary bucket and publishes &lt;code&gt;vector.embedding.ready&lt;/code&gt; on the orchestration bus. Document, text and data files also get one vector per content chunk. Otherwise the embedding is recorded as skipped and the run goes to its end step." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="879" width="534" height="98" as="geometry" />
        </mxCell>
        <mxCell id="panel-b9" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;9&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="1022" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t9" value="When the media branch planned video windows (&lt;code&gt;VIDEO_SEGMENT_SECONDS&lt;/code&gt;) and the whole-file embedding succeeded, an &lt;b&gt;AWS Step Functions&lt;/b&gt; Distributed Map runs one express child execution per window, eight at a time. Each child describes the window's frames with the analysis model, embeds the description with the file's context and publishes one more event." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="993" width="534" height="83" as="geometry" />
        </mxCell>
        <mxCell id="panel-b10" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;10&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="1113.5" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t10" value="With vector search enabled, an &lt;b&gt;Amazon EventBridge&lt;/b&gt; rule on the bus sends each event to the &lt;b&gt;Amazon SQS&lt;/b&gt; vector indexer queue. The vector indexer (&lt;b&gt;AWS Lambda&lt;/b&gt;) reads the embedding document, writes the vector item to the &lt;b&gt;Amazon DynamoDB&lt;/b&gt; vector embeddings table, marks the file's other versions as not latest and deletes the document." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="1092" width="534" height="68" as="geometry" />
        </mxCell>
        <mxCell id="panel-b11" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#ffffff;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1388" y="1190" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="panel-t11" value="The end step reports success or failure to the VAMS workflow through the task token, and the workflow's process-output step applies the attribute and metadata files to the file and the asset in &lt;b&gt;Amazon DynamoDB&lt;/b&gt;." style="text;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="layer-workflow">
          <mxGeometry x="1424" y="1176" width="534" height="53" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>