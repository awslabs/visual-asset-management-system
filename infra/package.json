{
    "name": "infra",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "bin": {
        "infra": "bin/infra.js"
    },
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=11.10.0 <12"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "jest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "cdk": "cdk",
        "cdk.synth.app": "cdk synth --all --require-approval never",
        "cdk.deploy.app": "cdk deploy --all --require-approval never",
        "deploy.dev": "npm run cdk.deploy.app --",
        "deploy.vams": "npm run cdk.deploy.app --",
        "gen": "ts-node ./gen/genEndpoints.ts",
        "check.account": "ts-node ./scripts/assertManifestAccount.ts",
        "check.quotas": "ts-node ./scripts/assertDeployQuotas.ts"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "aws-cdk": "^2.1148.0",
        "esbuild": "^0.28.2",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-morph": "^28.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@aws-cdk/aws-lambda-python-alpha": "^2.275.0-alpha.0",
        "@aws-sdk/client-iam": "^3.1164.0",
        "@aws-sdk/client-ssm": "^3.1164.0",
        "@opensearch-project/opensearch": "^3.9.0",
        "@types/aws-lambda": "^8.10.164",
        "@types/aws4": "^1.11.6",
        "aws-cdk-lib": "^2.275.0",
        "aws4": "^1.13.2",
        "cdk-nag": "^2.38.2",
        "constructs": "^10.8.1",
        "dotenv": "^17.4.2",
        "source-map-support": "^0.5.21"
    },
    "overrides": {
        "@istanbuljs/load-nyc-config": {
            "js-yaml": "^4.2.0"
        }
    },
    "optionalDependencies": {
        "@esbuild/darwin-arm64": "^0.28.2",
        "@esbuild/darwin-x64": "^0.28.2",
        "@esbuild/linux-x64": "^0.28.2"
    }
}
