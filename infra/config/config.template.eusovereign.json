        "api": {
            "apiType": "APIGATEWAY_REST",
            "apiGatewayRest": {
                "globalRateLimit": 50,
                "globalBurstLimit": 100,
                "endpointType": "REGIONAL",
                "optionalExternalPrivateApigVPCEId": "",
