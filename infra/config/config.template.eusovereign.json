        "useAlb": {
            "enabled": true,
            "usePublicSubnet": false,
            "addAlbS3SpecialVpcEndpoint": true,
            "domainHost": "vams1.example.com",
            "certificateArn": "arn:aws-eusc:acm:<REGION>:<ACCOUNTID>:certificate/<CERTIFICATEID>",
            "optionalHostedZoneId": null
        },
        "useCloudFront": {
            "enabled": false,
            "customDomain": {
                "enabled": false,
                "domainHost": "",
                "certificateArn": "",
                "optionalHostedZoneId": ""
            }
        },
        "pipelines": {
            "deadlineCloudExecutionTypeEnabled": false,
            "useConversion3dBasic": {
                "enabled": true,
                "autoRegisterWithVAMS": true
