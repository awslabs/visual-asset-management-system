                    "enabled": false,
                    "ecrContainerImageURI": "<ACCOUNTID>.dkr.ecr.<REGION>.amazonaws.eu/<ECR-REPOSITORY>/<IMAGE-ID>:<IMAGE-TAG>",
                    "autoRegisterWithVAMS": true
                },
                "useEks": {
                    "enabled": false,
                    "ecrContainerImageURI": "<ACCOUNTID>.dkr.ecr.<REGION>.amazonaws.eu/<ECR-REPOSITORY>/<IMAGE-ID>:<IMAGE-TAG>",
