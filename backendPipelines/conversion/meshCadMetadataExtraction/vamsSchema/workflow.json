{
    "workflowName": "CAD/Mesh Metadata Extraction",
    "category": "Conversion",
    "description": "Basic Metadata Attribute Extraction (File-level metadata) - using Trimesh and CADQuery library. Supported files are STL, OBJ, PLY, GLTF, GLB, 3MF, XAML, 3DXML, DAE, XYZ, STP, DXF.",
    "triggers": [
        {
            "triggerType": "fileUpload",
            "inputFileFilters": {
                "allow": [
                    "*.stl",
                    "*.obj",
                    "*.ply",
                    "*.gltf",
                    "*.glb",
                    "*.3mf",
                    "*.xaml",
                    "*.3dxml",
                    "*.dae",
                    "*.xyz",
                    "*.stp",
                    "*.step",
                    "*.dxf"
                ],
                "exclude": []
            },
            "defaultTemplateIds": {},
            "enabled": false
        }
    ]
}
