{
    "workflowName": "GenAI 3D Metadata Labeling",
    "category": "GenAI",
    "description": "GenAI 3D Metadata Labeling Pipeline (Asset-level metadata generation from file) - 3D Mesh files using Blender Image Extraction. Supported Input Formats: OBJ, GLB, FBX, ABC, PLY, STL",
    "systemConfig": {
        "inputFileArity": "one",
        "assetScope": {
            "crossAssetAllowed": false,
            "singleAssetOnly": true,
            "wholeAssetAllowed": false,
            "folderAllowed": false
        },
        "metadataInputs": {
            "assetMetadata": true,
            "fileMetadata": true,
            "fileAttributes": true
        },
        "inputFileFilters": {
            "allow": ["*.stl", "*.obj", "*.ply", "*.glb", "*.abc", "*.fbx"],
            "exclude": []
        },
        "concurrencyRestriction": "none",
        "outputTarget": {
            "locationType": "asset",
            "allowOverride": false
        },
        "allowWorkflowTriggerChaining": true
    },
    "triggers": [
        {
            "triggerType": "fileUpload",
            "inputFileFilters": {
                "allow": ["*.stl", "*.obj", "*.ply", "*.glb", "*.abc", "*.fbx"],
                "exclude": []
            },
            "defaultTemplateIds": {
                "GLOBAL:genai-metadata-3d-labeling-obj-glb-fbx-ply-stl-usd": "metadata-3d-labeling-default"
            },
            "enabled": false
        }
    ]
}
