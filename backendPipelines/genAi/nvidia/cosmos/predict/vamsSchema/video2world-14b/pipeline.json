{
    "pipelineName": "NVIDIA Cosmos Video-to-World 14B v2",
    "category": "WFM",
    "description": "NVIDIA Cosmos Video-to-World 14B v2 - Generate high-quality videos from video + text input (Predict2.5)",
    "executionConfig": {
        "executionType": "Lambda",
        "waitForCallback": "Enabled",
        "taskTimeout": "28800",
        "taskHeartbeatTimeout": "",
        "lambda": {}
    },
    "systemConfig": {
        "inputFileArity": "one",
        "assetScope": {
            "wholeAsset": false
        },
        "metadataInputs": {
            "assetMetadata": true,
            "fileMetadata": true,
            "fileAttributes": false
        },
        "requireTemplate": true,
        "allowCustomTemplateOverride": true,
        "inputFileFilters": {
            "allow": ["*.mp4", "*.mov", "*.jpg", "*.jpeg", "*.png", "*.webp"],
            "exclude": []
        }
    }
}
