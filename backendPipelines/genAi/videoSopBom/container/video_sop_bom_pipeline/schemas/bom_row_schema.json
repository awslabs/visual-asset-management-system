{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "vams:videoSopBom/bom_row_schema.json",
    "title": "bom.json",
    "description": "The bill of materials. rows carries one lcaRow per BOM line in the 66-column LCA-BOM-INPUT order; bom.csv writes the same rows under the byte-exact header, null rendering as an empty cell. A part_type or material_or_component_type outside the vocabulary is null with the raw value kept in material_notes. draftRow is the compact shape the model emits per window.",
    "type": "object",
    "additionalProperties": false,
    "required": ["rows"],
    "properties": {
        "product_name": { "type": "string" },
        "part_level_base": {
            "description": "The PART_LEVEL_BASE tag as rendered into the config (partLevelBase).",
            "type": "string",
            "enum": ["0", "1"]
        },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/lcaRow" } }
    },
    "$defs": {
        "partType": {
            "type": "string",
            "enum": [
                "Camera or Light Sensing Device",
                "Chemicals",
                "Protective Materials",
                "Connector",
                "Enclosure",
                "FPC",
                "Product Assembly Accessory",
                "Product Assembly Device",
                "Packaged Product Assembly",
                "Cable",
                "Electronics",
                "IC",
                "Mid-Frame",
                "Soft Goods",
                "Packaging",
                "Threaded Fasteners",
                "Mechanical Hardware",
                "Display",
                "Packout Assembly",
                "ODM Part",
                "Label",
                "Frame",
                "PCB",
                "PCBA",
                "Print Materials",
                "Passive Electrical Device",
                "Sub-Assembly",
                "Electromechanical Device",
                "Raw Material",
                "Battery Assembly"
            ]
        },
        "materialOrComponentType": {
            "type": "string",
            "enum": [
                "Battery - Assembly",
                "Camera Module - Assembly",
                "Connector - Assembly",
                "Display - Assembly",
                "Enclosure - Assembly",
                "FPC - Assembly",
                "Frame - Assembly",
                "Hinge - Assembly",
                "Microphone - Assembly",
                "Optical Module - Assembly",
                "Packaging - Assembly",
                "Packaging Primary - Assembly",
                "Packaging Secondary - Assembly",
                "PCBA - Assembly",
                "Power Supply Unit - Assembly",
                "Product Assembly Accessory",
                "Packaged Product Assembly",
                "Product Assembly Device",
                "Speaker - Assembly",
                "Thermal Management- Assembly",
                "Touch Panel - Assembly",
                "Actuator - Component",
                "Antenna - Component",
                "Battery - Component",
                "Bracket Mounting - Component",
                "Button - Component",
                "Cable - Component",
                "Cable Power - Component",
                "Cable USB - Component",
                "Capacitor - Component",
                "Connector - Component",
                "Connector Power - Component",
                "Connector USB - Component",
                "Contact Pad - Component",
                "Cover Lens - Component",
                "EMI Shield - Component",
                "Fan - Component",
                "Ferrite Core - Component",
                "Filter RF - Component",
                "FPC - Component",
                "Fuse - Component",
                "Gasket - Component",
                "Glass Front - Component",
                "Glass Touch - Component",
                "Heat Pipe - Component",
                "Heat Sink - Component",
                "Housing Back - Component",
                "Housing Front - Component",
                "IC Memory - Component",
                "IC Power - Component",
                "IC Processor - Component",
                "Inductor - Component",
                "LED - Component",
                "LED Housing - Component",
                "LED Optical Stack -Component",
                "LED Panel - Component",
                "Mid-Frame - Component",
                "Padding - Component",
                "Protective Pading - Component",
                "Resistor - Component",
                "Thermal Pad - Component",
                "Alloys - Aluminum",
                "Alloys - Copper",
                "Alloys - Nickel",
                "Alloys - Other",
                "Aluminum",
                "Ceramic",
                "Copper",
                "Copper Alloys",
                "Nickel",
                "REE Magnetic Material",
                "Steel",
                "Stainless Steel",
                "Titanium",
                "Zinc",
                "Glass",
                "Bio-PU",
                "Cellulose",
                "Cellulose Acetate",
                "Cork",
                "Corrugated Paper",
                "Desserto",
                "Fibers - Cellulose",
                "Fibers - Cotton",
                "Fibers - Hemp",
                "Fibers - Linen",
                "Fibers - Wool",
                "Hardwood",
                "Hazelnut SOC",
                "Leather - Cork",
                "Leather - Cow",
                "Leather - Other",
                "Leather - Vegan",
                "Mars SOC",
                "Paper",
                "Pinatex",
                "Rice Hulls",
                "Softwood",
                "Starch",
                "SVT2180 Braskem",
                "Trifilon",
                "UPM",
                "Wood pulp",
                "ABS",
                "Bio - PU",
                "EPDM",
                "EVA",
                "FEP",
                "HDPE",
                "HIPS",
                "LDPE",
                "NBR",
                "PA",
                "PC",
                "PC GF20",
                "PC GF30",
                "PC/ABS",
                "PDMS",
                "PE",
                "PEEK",
                "PET",
                "Plastic",
                "PMMA",
                "Polystyrene",
                "POM",
                "PP",
                "PTFE",
                "PU",
                "PU Foam",
                "PVAc",
                "TPE",
                "TPU"
            ]
        },
        "primaryManufacturingTechnique": {
            "description": "The material table's Primary Manufacturing Techniques column (vocabulary b).",
            "type": "string",
            "enum": [
                "Assembly- FATP-Electronics",
                "Assembly - General",
                "Assembly - FATP - Touch & Display",
                "Molding - Plastics",
                "R2R Circuit Processing",
                "Forming - Metalwork",
                "SMT",
                "Assembly - FATP",
                "Assembly - Electro-Mechanical",
                "Assembly - Electrical Component",
                "Electrode Coating and Winding",
                "Assembly - Electromechanical Component",
                "Cable Processing",
                "Passive Electronics Processing",
                "Thin-Film Deposition",
                "Glass Making Process",
                "Semiconductor Device Fabrication",
                "Optical Film Processing",
                "Chemical Mixing",
                "Forming - Ceramics",
                "Chemical",
                "Polymer Synthesis - Bio-Based Polymers",
                "Biomass Processing",
                "Corrugator",
                "Tanning",
                "Natural Fiber Textile Processing",
                "Woodworking",
                "Papermaking"
            ]
        },
        "secondaryManufacturingTechnique": {
            "type": "string",
            "enum": [
                "Smelting",
                "Polymer Synthesis - Bio-Based Polymers",
                "Polymer Synthesis - Thermoplastic",
                "Polymer Synthesis - Thermoset",
                "Polymer Synthesis - Fluoropolymer",
                "Polymer Compounding",
                "Polymer Foaming"
            ]
        },
        "yesNo": { "type": "string", "enum": ["Yes", "No"] },
        "methodForWeight": { "type": "string", "enum": ["Measured", "Derived from CAD"] },
        "countryCode": {
            "description": "ISO 3166-1 alpha-2 (country_list.csv Code column).",
            "type": "string",
            "pattern": "^[A-Z]{2}$"
        },
        "icType": { "type": "string", "enum": ["Logic", "DRAM", "NAND"] },
        "icPackageType": {
            "type": "string",
            "enum": [
                "BGA",
                "DFN",
                "DIP",
                "Flip Chip",
                "PLCC",
                "QFN",
                "QFP",
                "SO",
                "SSOP",
                "TQFP",
                "TSOP",
                "TSSOP",
                "WLP CSP"
            ]
        },
        "icProcessNodePrimary": {
            "type": "string",
            "enum": [
                "A10",
                "A14",
                "N2",
                "N3",
                "N5",
                "N7",
                "N10",
                "N14",
                "N20",
                "N28",
                "N45",
                "N65",
                "N90",
                "N130",
                "N250",
                "1a",
                "1x",
                "1y",
                "1z",
                "N57",
                "32L",
                "48L",
                "64L",
                "96L",
                "128L",
                "176L",
                "238L",
                "288L",
                "352L"
            ]
        },
        "icProcessNodeSecondary": {
            "type": "string",
            "enum": ["EUV", "EUV_HPC", "HPC", "None", "1D_CoA", "2D_CuA", "2D_CoA", "3D_CuA"]
        },
        "pcbType": { "type": "string", "enum": ["Flex", "Rigid"] },
        "pcbBoardFinish": { "type": "string", "enum": ["ENIG", "OSP"] },
        "displayType": {
            "type": "string",
            "enum": ["LCD-INCELL", "LCD-OUTCELL", "LCD-TV", "LCD", "EPD", "OLED"]
        },
        "batteryType": {
            "type": "string",
            "enum": [
                "Battery-Alkaline",
                "Battery-LCO",
                "Battery-LiPo",
                "Battery-NCA",
                "Battery-NCM(811)",
                "Battery-LCO:NCM",
                "Battery-LCO Recycled Co",
                "Battery-LCO Recycled Li+Co"
            ]
        },
        "pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "frac": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "optNum": { "type": ["number", "null"], "minimum": 0 },
        "optStr": { "type": ["string", "null"] },
        "draftRow": {
            "description": "The compact component observation the model emits per window (part_level is base 0 here; the renderer adds partLevelBase).",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "part_level",
                "part_type",
                "part_description",
                "qty",
                "material_or_component_type",
                "mass_g_per_unit",
                "primary_manufacturing_process"
            ],
            "properties": {
                "part_level": { "type": "integer", "minimum": 0, "maximum": 5 },
                "part_type": { "type": "string" },
                "part_description": { "type": "string", "minLength": 1 },
                "qty": { "type": "number", "exclusiveMinimum": 0 },
                "material_or_component_type": { "type": "string" },
                "mass_g_per_unit": { "type": ["number", "null"], "minimum": 0 },
                "primary_manufacturing_process": { "type": ["string", "null"] }
            }
        },
        "lcaRow": {
            "description": "One row of LCA-BOM-INPUT.csv, 66 columns in header order. The first eight are the ForeSIE-required columns (present on every row; part_type and material_or_component_type are null only for a vocabulary miss, whose raw value material_notes keeps); everything else is null unless observable.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "part_level",
                "part_type",
                "lab_part_number",
                "manufacturer_part_number",
                "alternative",
                "part_description",
                "qty",
                "material_or_component_type"
            ],
            "properties": {
                "part_level": { "type": "integer", "minimum": 0, "maximum": 6 },
                "part_type": { "anyOf": [{ "$ref": "#/$defs/partType" }, { "type": "null" }] },
                "lab_part_number": {
                    "description": "<productSlug>-<seq:03d>, unique per row.",
                    "type": "string",
                    "minLength": 1
                },
                "manufacturer_part_number": {
                    "description": "Printed or stated MPN; empty string when unknown (the one required string that may be empty).",
                    "type": "string"
                },
                "alternative": { "$ref": "#/$defs/yesNo" },
                "part_description": { "type": "string", "minLength": 1 },
                "qty": { "type": "number", "exclusiveMinimum": 0 },
                "material_or_component_type": {
                    "anyOf": [{ "$ref": "#/$defs/materialOrComponentType" }, { "type": "null" }]
                },
                "material_notes": { "$ref": "#/$defs/optStr" },
                "material_composition": { "$ref": "#/$defs/pct" },
                "material_percent_recycled_content": { "$ref": "#/$defs/pct" },
                "mass_g_per_unit": { "type": ["number", "null"], "minimum": 0 },
                "manufacturing_country": {
                    "anyOf": [{ "$ref": "#/$defs/countryCode" }, { "type": "null" }]
                },
                "supplier_carbon_footprint_kgCO2e_per_unit": { "$ref": "#/$defs/optNum" },
                "defect_loss": { "$ref": "#/$defs/frac" },
                "method_for_weight": {
                    "anyOf": [{ "$ref": "#/$defs/methodForWeight" }, { "type": "null" }]
                },
                "primary_manufacturing_process": {
                    "anyOf": [
                        { "$ref": "#/$defs/primaryManufacturingTechnique" },
                        { "type": "null" }
                    ]
                },
                "primary_mfg_yield_loss": { "$ref": "#/$defs/frac" },
                "primary_mfg_ref_unit": { "$ref": "#/$defs/optStr" },
                "primary_mfg_elect_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "primary_elect_from_RE_purchased_percent": { "$ref": "#/$defs/pct" },
                "primary_RE_wind_percent": { "$ref": "#/$defs/pct" },
                "primary_RE_solar_percent": { "$ref": "#/$defs/pct" },
                "primary_elect_from_RE_onsite_percent": { "$ref": "#/$defs/pct" },
                "primary_mfg_natural_gas_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "primary_mfg_f_gas_ghg_emissions_kgCO2e_per_unit": { "$ref": "#/$defs/optNum" },
                "primary_mfg_other_direct_ghg_emissions_kgCO2e_per_unit": {
                    "$ref": "#/$defs/optNum"
                },
                "primary_mfg_water_consumption_m3": { "$ref": "#/$defs/optNum" },
                "secondary_manufacturing_process": {
                    "anyOf": [
                        { "$ref": "#/$defs/secondaryManufacturingTechnique" },
                        { "type": "null" }
                    ]
                },
                "secondary_mfg_yield_loss": { "$ref": "#/$defs/frac" },
                "secondary_mfg_ref_unit": { "$ref": "#/$defs/optStr" },
                "secondary_mfg_elect_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "secondary_elect_from_RE_purchased_percent": { "$ref": "#/$defs/pct" },
                "secondary_RE_wind_percent": { "$ref": "#/$defs/pct" },
                "secondary_RE_solar_percent": { "$ref": "#/$defs/pct" },
                "secondary_elect_from_RE_onsite_percent": { "$ref": "#/$defs/pct" },
                "secondary_mfg_natural_gas_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "secondary_mfg_f_gas_ghg_emissions_kgCO2e_per_unit": { "$ref": "#/$defs/optNum" },
                "secondary_mfg_other_direct_ghg_emissions_kgCO2e_per_unit": {
                    "$ref": "#/$defs/optNum"
                },
                "secondary_mfg_water_consumption_m3": { "$ref": "#/$defs/optNum" },
                "ic_type": { "anyOf": [{ "$ref": "#/$defs/icType" }, { "type": "null" }] },
                "ic_process_node_primary": {
                    "anyOf": [{ "$ref": "#/$defs/icProcessNodePrimary" }, { "type": "null" }]
                },
                "ic_process_node_secondary": {
                    "anyOf": [{ "$ref": "#/$defs/icProcessNodeSecondary" }, { "type": "null" }]
                },
                "ic_die_size_mm2": { "$ref": "#/$defs/optNum" },
                "ic_mfg_abatement": { "$ref": "#/$defs/pct" },
                "ic_package_type": {
                    "anyOf": [{ "$ref": "#/$defs/icPackageType" }, { "type": "null" }]
                },
                "ic_package_length_mm": { "$ref": "#/$defs/optNum" },
                "ic_package_width_mm": { "$ref": "#/$defs/optNum" },
                "ic_package_depth_mm": { "$ref": "#/$defs/optNum" },
                "ic_yield_loss": { "$ref": "#/$defs/frac" },
                "ic_frontend_elect_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "ic_backend_elect_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "ic_f_gas_per_unit_kg_CO2e": { "$ref": "#/$defs/optNum" },
                "ic_other_direct_ghg_per_unit_kg_CO2e": { "$ref": "#/$defs/optNum" },
                "pcb_board_area_cm2": { "$ref": "#/$defs/optNum" },
                "pcb_type": { "anyOf": [{ "$ref": "#/$defs/pcbType" }, { "type": "null" }] },
                "pcb_layers": { "type": ["integer", "null"], "minimum": 1 },
                "pcb_shipping_panel_utilization": { "$ref": "#/$defs/frac" },
                "pcb_material_utilization": { "$ref": "#/$defs/frac" },
                "pcb_board_finish": {
                    "anyOf": [{ "$ref": "#/$defs/pcbBoardFinish" }, { "type": "null" }]
                },
                "pcb_elect_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "display_type": {
                    "anyOf": [{ "$ref": "#/$defs/displayType" }, { "type": "null" }]
                },
                "display_active_area_cm2": { "$ref": "#/$defs/optNum" },
                "display_elect_consumption_kwh_per_unit": { "$ref": "#/$defs/optNum" },
                "battery_type": {
                    "anyOf": [{ "$ref": "#/$defs/batteryType" }, { "type": "null" }]
                },
                "battery_capacity_wh": { "$ref": "#/$defs/optNum" }
            }
        }
    }
}
