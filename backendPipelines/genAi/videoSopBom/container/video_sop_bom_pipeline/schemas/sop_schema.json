{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "vams:videoSopBom/sop_schema.json",
    "title": "sop.json",
    "description": "Standard operating procedure derived from the narrated teardown. title is deterministic (<product name> — teardown SOP); the model produces summary and safety_notes only. Step fields follow IdealSteps.md; every field is present, empty lists or null standing for unknown.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "title",
        "product_name",
        "product_name_from_narration",
        "source_videos",
        "summary",
        "safety_notes",
        "steps"
    ],
    "properties": {
        "title": { "type": "string", "minLength": 1 },
        "product_name": {
            "description": "PRODUCT_NAME tag, else the asset name.",
            "type": "string"
        },
        "product_name_from_narration": {
            "description": "Product/model string the model heard in the narration.",
            "type": ["string", "null"]
        },
        "source_videos": {
            "description": "Asset-relative input paths in timeline order.",
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "pattern": "^/.+" }
        },
        "summary": { "type": "string" },
        "safety_notes": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
    },
    "$defs": {
        "dependency": {
            "description": "A precondition. step names the SOP step that satisfies it when one was captured; text keeps the prose either way.",
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "text"],
            "properties": {
                "step": { "type": ["integer", "null"], "minimum": 1 },
                "text": { "type": "string" }
            }
        },
        "step": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "step",
                "action",
                "component",
                "fasteners",
                "locations",
                "dependencies",
                "tools",
                "motion",
                "force",
                "failure_modes",
                "notes",
                "timestamp_seconds",
                "video_index",
                "local_timestamp_seconds",
                "frame_ref",
                "bom_refs"
            ],
            "properties": {
                "step": { "type": "integer", "minimum": 1 },
                "action": {
                    "description": "What to do (remove, disconnect, pry, lift).",
                    "type": "string"
                },
                "component": { "description": "What is acted on.", "type": "string" },
                "fasteners": {
                    "description": "What holds it, e.g. 4x Phillips #00 screws.",
                    "type": "array",
                    "items": { "type": "string" }
                },
                "locations": {
                    "description": "Where exactly.",
                    "type": "array",
                    "items": { "type": "string" }
                },
                "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
                "tools": { "type": "array", "items": { "type": "string" } },
                "motion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["allowed", "restricted"],
                    "properties": {
                        "allowed": {
                            "description": "Permitted directions.",
                            "type": "array",
                            "items": { "type": "string" }
                        },
                        "restricted": {
                            "description": "Forbidden directions and why.",
                            "type": "array",
                            "items": { "type": "string" }
                        }
                    }
                },
                "force": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["amount", "indicator"],
                    "properties": {
                        "amount": {
                            "type": ["string", "null"],
                            "enum": ["light", "moderate", "firm", null]
                        },
                        "indicator": {
                            "description": "How to know it is right.",
                            "type": ["string", "null"]
                        }
                    }
                },
                "failure_modes": { "type": "array", "items": { "type": "string" } },
                "notes": { "type": "string" },
                "timestamp_seconds": {
                    "description": "Global (concatenated) timeline.",
                    "type": "number",
                    "minimum": 0
                },
                "video_index": { "type": "integer", "minimum": 0 },
                "local_timestamp_seconds": { "type": "number", "minimum": 0 },
                "frame_ref": {
                    "description": "Post-extension asset path (/sop-bom/<executionId>/keyframe-…jpg) of the key frame for this step, if one was extracted.",
                    "type": ["string", "null"],
                    "pattern": "^/sop-bom/.+\\.jpg$"
                },
                "bom_refs": {
                    "description": "lab_part_number values of the BOM rows this step touches.",
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        }
    }
}
