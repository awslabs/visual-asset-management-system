# VAMS Image to 3D Pipeline Container -- Tencent Hunyuan3D-2
# Upstream: https://github.com/Tencent-Hunyuan/Hunyuan3D-2
# Weights: https://huggingface.co/tencent/Hunyuan3D-2

# LICENSING: the code and weights are under the Tencent Hunyuan 3D 2.0 Community License Agreement, which
# permits commercial use but only inside a Territory defined as the world EXCLUDING the European Union, the
# United Kingdom and South Korea, and requires a separate licence from Tencent above one million monthly
# active users. getConfig() refuses to enable this model in a region outside the Territory. Unlike its two
# textured peers this image pulls NO nvdiffrast: the texture stage ships its own rasteriser, so nothing here
# carries the NVIDIA Source Code License's research-or-evaluation-only restriction.

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04@sha256:24c8e3581ea6330038b0d374920721983312627f8adbfcf390bdb4b399d280ed

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Non-root runtime user (the #327 design), created first so HOME is /home/vams for every step below:
# anything a build step writes under HOME (git-lfs's .gitconfig, tool caches) lands where uid 10000 can
# reach it at run time.
RUN groupadd -g 10000 vams && \
    useradd -u 10000 -g 10000 -m -d /home/vams -s /bin/bash vams
ENV HOME=/home/vams

# The upstream repo is pinned to a reviewed commit so the image is reproducible; the clone below fails the
# build if HEAD is anything else. This commit is the one the adapter's driver was
# written against: from_pretrained takes (repo, subfolder, variant, use_safetensors, device), the shape
# pipeline's __call__ has no seed parameter and takes a generator, and the paint pipeline is called as
# (mesh, image=...).
# pragma: allowlist nextline secret
ARG HUNYUAN3D_COMMIT=f8db63096c8282cb27354314d896feba5ba6ff8a
# The GPL-3.0 mesh-repair rungs (pymeshfix, pymeshlab) complete the repair ladder. A run selects which
# rungs it walks through the template's REPAIR_BACKENDS setting.
ARG ENABLE_GPL_MESH_REPAIR=true

# Install system dependencies. The GL/EGL libraries back the texture stage's own rasteriser; cmake and
# ninja build the two CUDA/C++ extensions it ships.
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    build-essential \
    cmake \
    curl \
    git \
    git-lfs \
    libegl1 \
    xvfb \
    libgl1 \
    libopengl0 \
    libglu1-mesa \
    libgles2 \
    libglib2.0-0 \
    ninja-build \
    python3 \
    python3-dev \
    python3-venv \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN git lfs install

# Install AWS CLI v2 at a fixed version, checked against its SHA-256 before it is installed. A
# --build-arg that moves the version has to move the digest with it.
ARG AWS_CLI_VERSION=2.36.39
ARG AWS_CLI_SHA256=2b337174417c159f8fd825637841f5425308108bd6f99681664409fb0d7ebe01
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" -o "awscliv2.zip" && \
    echo "${AWS_CLI_SHA256}  awscliv2.zip" | sha256sum -c - && \
    unzip -q awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

# Ubuntu 24.04 marks its system python as externally managed, so the pipeline and the upstream repo share
# one virtualenv that fronts PATH.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV=/opt/venv
# Every Python package of this image is installed from locks/hunyuan3d, hashed exports of its uv.lock (#1726): the
# same versions, from the same files, on every build. The lock holds the image's whole set, so nothing is resolved
# at build time and no later step can move a version. pip and the build tools come first from their own lock, then
# the rest with --require-hashes --no-deps: pip refuses a file whose hash is not in the lock and installs nothing the
# lock does not name. The two extensions built from source below compile AFTER this install, against the numpy and
# torch the image ships, and nothing installs a package after them.
COPY locks/hunyuan3d/requirements-build.lock locks/hunyuan3d/requirements.lock locks/hunyuan3d/requirements-gpl.lock locks/hunyuan3d/out-of-lock.json /opt/locks/hunyuan3d/
COPY locks/hunyuan3d/upstream /opt/locks/hunyuan3d/upstream
COPY locks/tools/check_installed_set.py locks/tools/check_upstream_requirements.py /opt/locks/tools/
RUN pip install --no-cache-dir --require-hashes --no-deps -r /opt/locks/hunyuan3d/requirements-build.lock

# CUDA 12.8 torch stack, at fixed versions, and the shared and upstream packages: torch and torchvision are the
# CUDA 12.8 builds from the PyTorch index (the lock pins them to 2.11.0+cu128 and the hashes are those files'),
# every other package comes from the default index. The upstream manifest declares no versions at all, so the lock
# is what fixes them; torch and torchvision are not taken from it (they are already pinned) and neither are
# pymeshlab (a GPL package, installed by its own step below) and the demo-only gradio, fastapi and uvicorn.
RUN pip install --no-cache-dir --require-hashes --no-deps \
    --extra-index-url https://download.pytorch.org/whl/cu128 \
    -r /opt/locks/hunyuan3d/requirements.lock

# Clone Hunyuan3D-2 at its pinned commit. Its dependency stack is already installed from the lock; the check after
# the clone fails the build when the upstream requirements.txt differs from the copy the lock was resolved from,
# which is what a moved HUNYUAN3D_COMMIT without a re-lock looks like.
RUN git clone https://github.com/Tencent-Hunyuan/Hunyuan3D-2.git /opt/hunyuan3d && \
    cd /opt/hunyuan3d && \
    git checkout --detach ${HUNYUAN3D_COMMIT} && \
    test "$(git rev-parse HEAD)" = "${HUNYUAN3D_COMMIT}" && \
    git rev-parse HEAD > /opt/hunyuan3d/VAMS_UPSTREAM_COMMIT && \
    python /opt/locks/tools/check_upstream_requirements.py \
        --recorded /opt/locks/hunyuan3d/upstream --clone /opt/hunyuan3d requirements.txt
WORKDIR /opt/hunyuan3d

# Every GPU family the pipeline can schedule onto has to be in this list, or an extension compiles for the
# wrong architecture and fails at runtime with "no kernel image is available for execution on the device".
# Ampere (8.6) covers g5 / A10G, Ada (8.9) covers g6 / L4 and g6e / L40S, and Hopper (9.0) covers H100.
ENV TORCH_CUDA_ARCH_LIST="8.6;8.9;9.0"
# nvcc parallelism, capped as the peers that also compile from source cap it: an uncapped job count
# exhausts the CodeBuild container's memory and the compile is killed rather than failing.
ENV MAX_JOBS=2

# The paint stage's diffusion pipeline lives in the repo at hy3dgen/texgen/hunyuanpaint rather than in
# diffusers, and current diffusers refuses to execute a custom pipeline without trust_remote_code=True.
# Upstream's call does not pass it and offers no way to pass it from outside, so it is set at the call
# site. The patch fails the build if the pinned revision has moved the call, rather than shipping a
# texture stage that dies on a GPU instance.
COPY patches/hunyuan3d_trust_remote_code.py /opt/ml/code/patches/hunyuan3d_trust_remote_code.py
RUN python /opt/ml/code/patches/hunyuan3d_trust_remote_code.py \
        /opt/hunyuan3d/hy3dgen/texgen/utils/multiview_utils.py

# The texture stage rasterises UVs and bakes views back onto the mesh through two extensions the repo
# carries itself. Not conditional: both directories exist at the pinned commit, and a build that skipped
# them silently would push an image whose texture stage fails at run time on a GPU instance. If a later
# commit moves them, the build fails here naming the path, which is where that belongs.
RUN set -eux; \
    pip install --no-cache-dir --no-build-isolation --no-deps \
        /opt/hunyuan3d/hy3dgen/texgen/custom_rasterizer; \
    pip install --no-cache-dir --no-build-isolation --no-deps \
        /opt/hunyuan3d/hy3dgen/texgen/differentiable_renderer

# GPL-3.0 mesh-repair rungs. Both VAMS build paths pass ENABLE_GPL_MESH_REPAIR=true, so every image
# carries them; only a hand-run build that sets it to false leaves them out.
RUN if [ "$ENABLE_GPL_MESH_REPAIR" = "true" ]; then \
        echo "Installing GPL-3.0 mesh repair backends (pymeshfix, pymeshlab)" && \
        pip install --no-cache-dir --require-hashes --no-deps -r /opt/locks/hunyuan3d/requirements-gpl.lock; \
    else \
        echo "GPL mesh repair backends not installed (ENABLE_GPL_MESH_REPAIR=$ENABLE_GPL_MESH_REPAIR)"; \
    fi

# The upstream packages are imported by the adapter's driver script, which runs with the repo root as its
# working directory; adding it to PYTHONPATH keeps the imports working from anywhere.
ENV PYTHONPATH="/opt/hunyuan3d:${PYTHONPATH}"

# The installed set is exactly the lock plus the two extensions built above: this fails the build on any package that
# is missing, extra or at another version than locks/hunyuan3d names (the GPL pair only when it was requested), and
# pip check confirms the declared dependencies of what is installed. The import check confirms the CUDA torch build
# survived and the repair stack the pipeline's own code is written against is present.
RUN python /opt/locks/tools/check_installed_set.py --dir /opt/locks/hunyuan3d --gpl "$ENABLE_GPL_MESH_REPAIR" && \
    pip check
RUN python -c "import trimesh, manifold3d, torch; \
assert '+cu' in torch.__version__, torch.__version__; \
print('trimesh', trimesh.__version__, 'torch', torch.__version__)"

# rembg resolves its segmentation weights under U2NET_HOME and downloads them on first use, defaulting to a
# home directory nothing carries between jobs. Pointing the variable at a baked-in copy removes the
# download entirely -- for this pipeline's own segmentation stage and for upstream's BackgroundRemover,
# which the driver reaches for when an image arrives without an alpha channel.
ENV U2NET_HOME=/opt/rembg
# Checked against its SHA-256; it is the same file rembg's own download checks by MD5.
ARG U2NET_SHA256=8d10d2f3bb75ae3b6d527c77944fc5e7dcd94b29809d47a739a7a728a912b491
RUN mkdir -p /opt/rembg && \
    curl -fsSL -o /opt/rembg/u2net.onnx \
    https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx && \
    echo "${U2NET_SHA256}  /opt/rembg/u2net.onnx" | sha256sum -c -

# VAMS container code
COPY __init__.py __main__.py model_manager.py preprocess.py framing.py generate.py benchmark.py meshcleanup.py printfeatures.py texturing.py export.py agent_broker.py config.json entrypoint.sh /opt/ml/code/
COPY models /opt/ml/code/models
COPY vams_utils /opt/ml/code/vams_utils
COPY hfguard /opt/ml/code/hfguard
# Strip CRLF line endings from entrypoint.sh in case the source was bundled from a Windows working tree;
# otherwise the shebang becomes `/bin/bash\r` and the kernel returns ENOENT on exec.
# COPY keeps the build host's mode bits, so a checkout made under umask 077 or 027 would leave files
# the runtime user cannot read: a+rX normalizes them.
RUN sed -i 's/\r$//' /opt/ml/code/entrypoint.sh && chmod +x /opt/ml/code/entrypoint.sh && \
    chmod -R a+rX /opt/ml/code
# The upstream checkout is the working directory of the model's process, and an upstream tool may
# create files relative to it. Group vams and mode 1775 let the runtime user add entries while the
# sticky bit keeps the root-owned sources as they are. HOME belongs to the runtime user.
RUN chgrp vams /opt/hunyuan3d && chmod 1775 /opt/hunyuan3d && chown -R vams:vams /home/vams
# Every HuggingFace download in this image is held to its pinned commit (hfguard/hf_pins.py). Checked
# at build time, so an image whose huggingface_hub lacks what the guard wraps fails here rather than
# on its first run.
RUN cd /opt/ml/code && python -c "from hfguard import hf_pins; assert hf_pins.install(), 'huggingface_hub is missing'"

WORKDIR /opt/ml/code
USER 10000:10000
ENTRYPOINT ["/opt/ml/code/entrypoint.sh"]
