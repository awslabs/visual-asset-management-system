# VAMS Image to 3D Pipeline Container -- Blender agent (Codex CLI on Amazon Bedrock)
# Blender: https://www.blender.org (GPL-2.0-or-later)
# Codex CLI: https://github.com/openai/codex (Apache-2.0)
# LiteLLM: https://github.com/BerriAI/litellm (MIT)
# MoGe-2: https://github.com/microsoft/MoGe (MIT; weights Ruicheng/moge-2-vitl-normal, MIT)
# utils3d: https://github.com/EasternJournalist/utils3d (MIT)
# PyTorch: https://pytorch.org (BSD-3-Clause)

# This image carries no neural reconstruction model. It carries a coding agent, a bridge from the agent's
# API to Amazon Bedrock, and a headless Blender the agent drives: the agent reads the reference photographs,
# writes Blender Python, renders, compares, and iterates until the model matches or the budget ends. Its one
# neural model is MoGe-2, a monocular depth estimator the scripted refit reads the photograph's relief from.
#
# LICENSING: Blender is GPL-2.0-or-later. It is a TOOL in this image -- the agent runs it as a separate
# process -- and the models it writes out are the agent's output, not derivatives of Blender, so the GPL
# attaches to redistributing this image and not to the meshes. Codex CLI is Apache-2.0 and LiteLLM is MIT.
# The foundation model's terms are Amazon Bedrock's for the model the deployment selects. MoGe-2 is MIT in
# code and weights, with a vendored DINOv2 under Apache-2.0; utils3d is MIT and PyTorch BSD-3-Clause. No
# nvdiffrast and no other NVIDIA-licensed source is built here.

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04@sha256:ac55d124da4882b497f732d8dfd9a702d5447a5f29d08d56da6f64f0a1eb34bc

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Non-root runtime user (the #327 design), created first so HOME is /home/vams for every step below:
# anything a build step writes under HOME (git-lfs's .gitconfig, tool caches) lands where uid 10000 can
# reach it at run time.
RUN groupadd -g 10000 vams && \
    useradd -u 10000 -g 10000 -m -d /home/vams -s /bin/bash vams
ENV HOME=/home/vams

# Pinned so the image is reproducible and so the agent's instructions match the Blender API they were
# written against. 4.5 is the LTS series; the tools use bpy.ops.wm.obj_import / stl_import and the glTF
# exporter's export_image_format, which are the 4.x names.
ARG BLENDER_VERSION="4.5.13"
ARG BLENDER_SERIES="4.5"
# The Codex CLI release, as a static musl binary. bwrap ships in the same release; the job does not use it:
# it needs a user namespace the unprivileged job does not get, so Codex runs its Landlock + seccomp sandbox
# (models/blenderagent.py).
ARG CODEX_RELEASE="rust-v0.153.4"
# The bridge that turns the Responses API Codex speaks into Bedrock Converse calls on the task role.
ARG LITELLM_VERSION="1.100.0"
# The GPL-3.0 mesh-repair rungs (pymeshfix, pymeshlab) complete the repair ladder. A run selects which
# rungs it walks through the template's REPAIR_BACKENDS setting.
ARG ENABLE_GPL_MESH_REPAIR=true

# System dependencies. The X/GL libraries are what Blender's binary links against even in background mode;
# without them it fails to start rather than to render.
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    ca-certificates \
    curl \
    git \
    libegl1 \
    libgl1 \
    libglu1-mesa \
    libgomp1 \
    libice6 \
    libsm6 \
    libx11-6 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxkbcommon0 \
    libxrender1 \
    libxxf86vm1 \
    python3 \
    python3-dev \
    python3-venv \
    ripgrep \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*
# ripgrep is what Codex reaches for to list and search files; without it the agent's first look at its
# workspace ends in "rg: command not found".

# Install AWS CLI v2 at a fixed version, checked against its SHA-256 before it is installed. A
# --build-arg that moves the version has to move the digest with it.
ARG AWS_CLI_VERSION=2.36.39
ARG AWS_CLI_SHA256=2b337174417c159f8fd825637841f5425308108bd6f99681664409fb0d7ebe01
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" -o "awscliv2.zip" && \
    echo "${AWS_CLI_SHA256}  awscliv2.zip" | sha256sum -c - && \
    unzip -q awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

# Ubuntu 24.04 marks its system python as externally managed, so the pipeline shares one virtualenv that
# fronts PATH. Blender carries its OWN Python and is not affected by this one.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV=/opt/venv
# Every Python package of this image is installed from locks/blenderagent, hashed exports of its uv.lock (#1726): the
# same versions, from the same files, on every build. The lock holds the image's whole set (the shared pipeline
# dependencies, the LiteLLM bridge and its dependencies, the CUDA 12.8 torch and the packages MoGe-2 imports), so
# nothing is resolved at build time and no later step can move a version. pip and the build tools come first from
# their own lock, then the rest with --require-hashes --no-deps: pip refuses a file whose hash is not in the lock and
# installs nothing the lock does not name. MoGe and utils3d are installed afterwards from pinned clones (no
# dependencies: theirs are in the lock). This is the pipeline's virtualenv; Blender runs its own bundled Python, which
# none of these packages reach.
COPY locks/blenderagent/requirements-build.lock locks/blenderagent/requirements.lock locks/blenderagent/requirements-gpl.lock locks/blenderagent/out-of-lock.json /opt/locks/blenderagent/
COPY locks/tools/check_installed_set.py /opt/locks/tools/
RUN pip install --no-cache-dir --require-hashes --no-deps -r /opt/locks/blenderagent/requirements-build.lock

# The shared pipeline dependencies, the bridge from the agent's Responses API to Bedrock (LiteLLM, the OpenAI client
# the adapter uses to check it, boto3) and torch with the packages MoGe-2 imports. torch is the CUDA 12.8 build from
# the PyTorch index (the lock pins 2.7.1+cu128 and the hashes are that file's); every other package comes from the
# default index. litellm-enterprise, which litellm[proxy] names, is left out of the lock (locks/blenderagent/
# pyproject.toml): the check below proves it is absent and that the proxy server the bridge runs imports without it.
RUN pip install --no-cache-dir --require-hashes --no-deps \
    --extra-index-url https://download.pytorch.org/whl/cu128 \
    -r /opt/locks/blenderagent/requirements.lock && \
    python -c "import torch; assert torch.version.cuda.startswith('12.8'), torch.version.cuda" && \
    litellm --version && \
    python -c "import importlib.util as u; assert u.find_spec('litellm_enterprise') is None; \
import litellm.proxy.proxy_server; print('LiteLLM proxy server imports without litellm_enterprise')"

# Blender, unpacked to /opt/blender and put on PATH. The primary download host is tried first and two
# public mirrors after it, because the primary has refused automated clients before. Whichever host
# answers, the tarball must match the SHA-256 Blender publishes for this release
# (blender-${BLENDER_VERSION}.sha256), so a mirror serving any other file fails the build; the version in
# the binary's own banner is asserted as well.
ARG BLENDER_SHA256=da4e69b06b75b9e642d106496c50e7e240218b411d2f6e18271c1d1d819cef91
RUN set -eux; \
    TARBALL="blender-${BLENDER_VERSION}-linux-x64.tar.xz"; \
    for base in "https://download.blender.org/release/Blender${BLENDER_SERIES}" \
                "https://ftp.nluug.nl/pub/graphics/blender/release/Blender${BLENDER_SERIES}" \
                "https://mirrors.dotsrc.org/blender/blender-release/Blender${BLENDER_SERIES}"; do \
        if curl -fsSL -A "Mozilla/5.0" -o "/tmp/${TARBALL}" "${base}/${TARBALL}"; then break; fi; \
    done; \
    echo "${BLENDER_SHA256}  /tmp/${TARBALL}" | sha256sum -c -; \
    mkdir -p /opt/blender; \
    tar -xJf "/tmp/${TARBALL}" -C /opt/blender --strip-components=1; \
    rm -f "/tmp/${TARBALL}"; \
    ln -sf /opt/blender/blender /usr/local/bin/blender; \
    blender --version | head -1 | grep -F "Blender ${BLENDER_VERSION}"

# Codex CLI and bwrap, from the pinned GitHub release, each checked against the SHA-256 the release
# publishes for it. Static binaries; nothing to compile.
ARG CODEX_SHA256=f479424eca092484dc40d87ae28c44f4cc40234a60045d6131e493800d814a30
ARG BWRAP_SHA256=e7d65c75e05637e42b93f6abf9222fa0d26b537648a7a34c122b75021d41756d
RUN set -eux; \
    BASE="https://github.com/openai/codex/releases/download/${CODEX_RELEASE}"; \
    curl -fsSL -o /tmp/codex.tar.gz "${BASE}/codex-x86_64-unknown-linux-musl.tar.gz"; \
    curl -fsSL -o /tmp/bwrap.tar.gz "${BASE}/bwrap-x86_64-unknown-linux-musl.tar.gz"; \
    printf '%s  %s\n' "${CODEX_SHA256}" /tmp/codex.tar.gz "${BWRAP_SHA256}" /tmp/bwrap.tar.gz | sha256sum -c -; \
    mkdir -p /tmp/codex /tmp/bwrap; \
    tar -xzf /tmp/codex.tar.gz -C /tmp/codex; \
    tar -xzf /tmp/bwrap.tar.gz -C /tmp/bwrap; \
    install -m 0755 "$(find /tmp/codex -type f -name 'codex*' | head -1)" /usr/local/bin/codex; \
    install -m 0755 "$(find /tmp/bwrap -type f -name 'bwrap*' | head -1)" /usr/local/bin/bwrap; \
    rm -rf /tmp/codex /tmp/bwrap /tmp/codex.tar.gz /tmp/bwrap.tar.gz; \
    codex --version

# The scripted refit's depth model, MoGe-2, and utils3d, which it imports. MoGe is cloned at a reviewed commit and
# installed without its declared dependencies: its model code imports torch, utils3d, huggingface_hub, OpenCV, SciPy
# and NumPy (all in the lock), and the rest of its list (torchvision, gradio and the demo apps' packages) serves its
# own apps. utils3d is built from a clone at a reviewed commit for the same reason; its dependencies are in the lock.
# Both are installed with pip's build isolation OFF, so the build runs with the setuptools and wheel the lock installed
# and downloads nothing, and with --no-deps so pip resolves nothing. The weights are fetched into the model cache at
# run time, like every other model's.
#
# utils3d is hash-checked: the clone must be at UTILS3D_COMMIT, and the SHA-256 over its tracked files (the digest of
# the sorted `sha256sum` lines of `git ls-files`) must equal UTILS3D_TREE_SHA256, recorded in out-of-lock.json too. A
# moved commit, or content that is not what was reviewed, fails the build.
ARG MOGE_REPO_URL="https://github.com/microsoft/MoGe.git"
ARG MOGE_COMMIT=07444410f1e33f402353b99d6ccd26bd31e469e8
ARG UTILS3D_COMMIT=3fab839f0be9931dac7c8488eb0e1600c236e183
ARG UTILS3D_TREE_SHA256=73f050a12b7ba005c2815d7e37784536b564d1eb57468a9e54e7303ed626f250
RUN git clone "$MOGE_REPO_URL" /opt/moge && \
    cd /opt/moge && \
    git checkout --detach ${MOGE_COMMIT} && \
    test "$(git rev-parse HEAD)" = "${MOGE_COMMIT}" && \
    git rev-parse HEAD > /opt/moge/VAMS_UPSTREAM_COMMIT && \
    pip install --no-cache-dir --no-build-isolation --no-deps /opt/moge
RUN git clone https://github.com/EasternJournalist/utils3d.git /tmp/utils3d && \
    cd /tmp/utils3d && \
    git checkout --detach ${UTILS3D_COMMIT} && \
    test "$(git rev-parse HEAD)" = "${UTILS3D_COMMIT}" && \
    { test "$(git ls-files -z | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)" = "${UTILS3D_TREE_SHA256}" || \
        { echo "utils3d at ${UTILS3D_COMMIT} does not match UTILS3D_TREE_SHA256: the files are not the ones that were reviewed"; exit 1; }; } && \
    mkdir -p /opt/vams-upstream && git rev-parse HEAD > /opt/vams-upstream/utils3d.VAMS_UPSTREAM_COMMIT && \
    pip install --no-cache-dir --no-build-isolation --no-deps /tmp/utils3d && \
    cd / && rm -rf /tmp/utils3d && \
    python -c "from moge.model.v2 import MoGeModel; import utils3d, cv2, huggingface_hub" && \
    echo "MoGe $(cat /opt/moge/VAMS_UPSTREAM_COMMIT)"

# GPL-3.0 mesh-repair rungs. Both VAMS build paths pass ENABLE_GPL_MESH_REPAIR=true, so every image
# carries them; only a hand-run build that sets it to false leaves them out.
RUN if [ "$ENABLE_GPL_MESH_REPAIR" = "true" ]; then \
        echo "Installing GPL-3.0 mesh repair backends (pymeshfix, pymeshlab)" && \
        pip install --no-cache-dir --require-hashes --no-deps -r /opt/locks/blenderagent/requirements-gpl.lock; \
    else \
        echo "GPL mesh repair backends not installed (ENABLE_GPL_MESH_REPAIR=$ENABLE_GPL_MESH_REPAIR)"; \
    fi

# The installed set is exactly the lock plus MoGe and utils3d, built above: this fails the build on any package that
# is missing, extra or at another version than locks/blenderagent names (the GPL pair only when it was requested), and
# the LiteLLM version must still be the one LITELLM_VERSION names. pip check confirms the declared dependencies of what
# is installed, with one exception: MoGe's own requirements list names the demo apps' packages (gradio, pipeline,
# torchvision) and the full OpenCV, which this image deliberately does not install (the model code imports none of
# them, and the import check above proves it). Any other unmet requirement fails the build.
RUN set -eu; \
    python /opt/locks/tools/check_installed_set.py --dir /opt/locks/blenderagent --gpl "$ENABLE_GPL_MESH_REPAIR"; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("litellm"))')" = "${LITELLM_VERSION}"; \
    pip check > /tmp/pip-check.txt || true; \
    unexpected=$(grep -v -E '^moge 2\.0\.0 requires (gradio|opencv-python|pipeline|torchvision), which is not installed\.$' /tmp/pip-check.txt || true); \
    rm -f /tmp/pip-check.txt; \
    if [ -n "$unexpected" ]; then echo "pip check: $unexpected"; exit 1; fi

# rembg resolves its segmentation weights under U2NET_HOME and downloads them on first use, defaulting to a
# home directory nothing carries between jobs. Pointing the variable at a baked-in copy removes the
# download entirely.
ENV U2NET_HOME=/opt/rembg
# Checked against its SHA-256; it is the same file rembg's own download checks by MD5.
ARG U2NET_SHA256=8d10d2f3bb75ae3b6d527c77944fc5e7dcd94b29809d47a739a7a728a912b491
RUN mkdir -p /opt/rembg && \
    curl -fsSL -o /opt/rembg/u2net.onnx \
    https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx && \
    echo "${U2NET_SHA256}  /opt/rembg/u2net.onnx" | sha256sum -c -

# The agent's workspace root. Outside /tmp deliberately: the sandbox carves /tmp out as writable by default
# and the pipeline's own directories live there, so the root sits elsewhere and the carve-outs are switched
# off in the agent's configuration. Recreated empty on every run.
RUN mkdir -p /var/agent
ENV BLENDERAGENT_ROOT=/var/agent

# VAMS container code
COPY __init__.py __main__.py model_manager.py preprocess.py framing.py generate.py benchmark.py meshcleanup.py printfeatures.py texturing.py export.py agent_broker.py config.json entrypoint.sh /opt/ml/code/
COPY models /opt/ml/code/models
COPY vams_utils /opt/ml/code/vams_utils
COPY hfguard /opt/ml/code/hfguard
# The Blender-side tools and the agent's instructions, copied into every workspace at run time.
COPY blenderagent_tools /opt/ml/code/blenderagent_tools
# Strip CRLF line endings from entrypoint.sh in case the source was bundled from a Windows working tree;
# otherwise the shebang becomes `/bin/bash\r` and the kernel returns ENOENT on exec.
# COPY keeps the build host's mode bits, so a checkout made under umask 077 or 027 would leave files
# the runtime user cannot read: a+rX normalizes them.
RUN sed -i 's/\r$//' /opt/ml/code/entrypoint.sh && chmod +x /opt/ml/code/entrypoint.sh && \
    chmod -R a+rX /opt/ml/code
# The runtime user owns every directory it writes: HOME and the agent's workspace root.
RUN chown -R vams:vams /home/vams /var/agent
# Every HuggingFace download in this image is held to its pinned commit (hfguard/hf_pins.py). Checked
# at build time, so an image whose huggingface_hub lacks what the guard wraps fails here rather than
# on its first run.
RUN cd /opt/ml/code && python -c "from hfguard import hf_pins; assert hf_pins.install(), 'huggingface_hub is missing'"

WORKDIR /opt/ml/code
USER 10000:10000
ENTRYPOINT ["/opt/ml/code/entrypoint.sh"]
