# VAMS Image to 3D Pipeline Container -- Stable-X Stable3DGen (Hi3DGen)
# Upstream: https://github.com/Stable-X/Stable3DGen (MIT)
# Weights:  https://huggingface.co/Stable-X/trellis-normal-v0-1 (MIT, geometry pipeline)
#           https://huggingface.co/Stable-X/yoso-normal-v1-8-1 (Apache-2.0, StableNormal predictor)
#           https://huggingface.co/ZhengPeng7/BiRefNet (MIT, background removal)
# Normal predictor code: https://github.com/hugoycj/StableNormal (Apache-2.0)
#
# Hi3DGen reconstructs geometry by bridging through a predicted normal map. It carries none of the
# NVIDIA-licensed components the TRELLIS lineage depends on -- kaolin, nvdiffrast and FlexiCubes are
# replaced by its own marching-cubes implementation over scikit-image -- so nothing here is built from
# source and the image raises no redistribution question. The model produces geometry only.

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04@sha256:24c8e3581ea6330038b0d374920721983312627f8adbfcf390bdb4b399d280ed

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Non-root runtime user (the #327 design), created first so HOME is /home/vams for every step below:
# anything a build step writes under HOME (git-lfs's .gitconfig, tool caches) lands where uid 10000 can
# reach it at run time.
RUN groupadd -g 10000 vams && \
    useradd -u 10000 -g 10000 -m -d /home/vams -s /bin/bash vams
ENV HOME=/home/vams

# The upstream repo is pinned to a reviewed commit so the image is reproducible; each clone below fails
# the build if HEAD is anything other than its pin.
# pragma: allowlist nextline secret
ARG STABLE3DGEN_COMMIT=c29f668ecec44b197275e9bf77f823c0c8a21076
# The normal predictor is loaded through torch.hub from a local checkout rather than fetched at run
# time, so its revision is pinned here too. Pinning it is not optional in practice: its hub entry
# point's signature has already moved away from what Stable3DGen's own demo calls it with, so a
# floating revision breaks the run rather than merely making the image irreproducible.
# pragma: allowlist nextline secret
ARG STABLENORMAL_COMMIT=1b7203c988384cb62286a25865d7354be8fdbbf7
# The predictor's backbone is itself pulled through torch.hub, which reaches GitHub at run time
# unless the checkout is already present. Pinned and baked in for the same reasons.
# pragma: allowlist nextline secret
ARG DINOV2_COMMIT=7764ea0f912e53c92e82eb78a2a1631e92725fc8
# The GPL-3.0 mesh-repair rungs (pymeshfix, pymeshlab) complete the repair ladder. A run selects
# which rungs it walks through the template's REPAIR_BACKENDS setting.
ARG ENABLE_GPL_MESH_REPAIR=true

# Install system dependencies. The GL/EGL libraries back trimesh's rendering paths and pymeshlab's
# plugins; libopengl0 is what pymeshlab's texture defragmentation filter links against.
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    build-essential \
    curl \
    git \
    git-lfs \
    libegl1 \
    xvfb \
    libgl1 \
    libopengl0 \
    libglu1-mesa \
    libgles2 \
    libglib2.0-0 \
    python3 \
    python3-dev \
    python3-venv \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN git lfs install

# Install AWS CLI v2 at a fixed version, checked against its SHA-256 before it is installed. A
# --build-arg that moves the version has to move the digest with it.
ARG AWS_CLI_VERSION=2.36.39
ARG AWS_CLI_SHA256=2b337174417c159f8fd825637841f5425308108bd6f99681664409fb0d7ebe01
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" -o "awscliv2.zip" && \
    echo "${AWS_CLI_SHA256}  awscliv2.zip" | sha256sum -c - && \
    unzip -q awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

# Ubuntu 24.04 marks its system python as externally managed, so the pipeline and the upstream repo
# share one virtualenv that fronts PATH.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV=/opt/venv
# Every Python package of this image is installed from locks/stable3dgen, hashed exports of its uv.lock
# (#1726): the same versions, from the same files, on every build. The lock holds the image's whole set, so
# nothing is resolved at build time and no later step can move a version. pip and the build tools come first
# from their own lock, then the rest with --require-hashes --no-deps: pip refuses a file whose hash is not in
# the lock and installs nothing the lock does not name.
COPY locks/stable3dgen/requirements-build.lock locks/stable3dgen/requirements.lock locks/stable3dgen/requirements-gpl.lock locks/stable3dgen/out-of-lock.json /opt/locks/stable3dgen/
COPY locks/stable3dgen/upstream /opt/locks/stable3dgen/upstream
COPY locks/tools/check_installed_set.py locks/tools/check_upstream_requirements.py /opt/locks/tools/
RUN pip install --no-cache-dir --require-hashes --no-deps -r /opt/locks/stable3dgen/requirements-build.lock

# torch, torchvision and xformers are the CUDA 12.8 builds from the PyTorch index (the lock pins torch to
# 2.10.0+cu128 and the hashes are those files'); every other package comes from the default index. The versions
# are pinned as a set: xformers 0.0.34 declares torch==2.10.0 exactly, and xformers is not optional -- the
# sparse attention module accepts only 'xformers' or 'flash_attn' and raises at import for anything else, so
# unlike the dense path it has no sdpa fallback, and flash_attn would mean the source compile this image exists
# to avoid.
RUN pip install --no-cache-dir --require-hashes --no-deps \
    --extra-index-url https://download.pytorch.org/whl/cu128 \
    -r /opt/locks/stable3dgen/requirements.lock

# GPL-3.0 mesh-repair rungs. Both VAMS build paths pass ENABLE_GPL_MESH_REPAIR=true, so every image
# carries them; only a hand-run build that sets it to false leaves them out.
RUN if [ "$ENABLE_GPL_MESH_REPAIR" = "true" ]; then \
        echo "Installing GPL-3.0 mesh repair backends (pymeshfix, pymeshlab)" && \
        pip install --no-cache-dir --require-hashes --no-deps -r /opt/locks/stable3dgen/requirements-gpl.lock; \
    else \
        echo "GPL mesh repair backends not installed (ENABLE_GPL_MESH_REPAIR=$ENABLE_GPL_MESH_REPAIR)"; \
    fi

# Clone Stable3DGen at its pinned commit. Its dependency stack is already installed from the lock; the check
# after the clone fails the build when the upstream requirements.txt differs from the copy the lock was
# resolved from, which is what a moved STABLE3DGEN_COMMIT without a re-lock looks like.
RUN git clone https://github.com/Stable-X/Stable3DGen.git /opt/stable3dgen && \
    cd /opt/stable3dgen && \
    git checkout --detach ${STABLE3DGEN_COMMIT} && \
    test "$(git rev-parse HEAD)" = "${STABLE3DGEN_COMMIT}" && \
    git rev-parse HEAD > /opt/stable3dgen/VAMS_UPSTREAM_COMMIT && \
    python /opt/locks/tools/check_upstream_requirements.py \
        --recorded /opt/locks/stable3dgen/upstream --clone /opt/stable3dgen requirements.txt
WORKDIR /opt/stable3dgen
# No CUDA extension is compiled in this image, so this list only affects any wheel that consults it.
# Ampere (8.6) covers g5 / A10G, Ada (8.9) covers g6 / L4 and g6e / L40S, Hopper (9.0) covers H100.
ENV TORCH_CUDA_ARCH_LIST="8.6;8.9;9.0"
# The diffusers bound and the sparse convolution backend the image used to install by hand are in the lock: upstream
# pins transformers exactly but leaves diffusers unbounded, and diffusers 0.37 imports a name the pinned
# transformers lacks (the lock keeps diffusers below it); spconv-cu126 is the newest variant publishing a cp312
# wheel, and runs against the CUDA 12.8 runtime through minor version compatibility.

# The normal predictor is loaded with torch.hub source='local', which expects the checkout under the
# hub directory named the way torch.hub names a GitHub repo: {owner}_{repo}_{branch}.
ENV TORCH_HOME=/opt/torchhome
RUN mkdir -p /opt/torchhome/hub && \
    git clone https://github.com/hugoycj/StableNormal.git /opt/torchhome/hub/hugoycj_StableNormal_main && \
    cd /opt/torchhome/hub/hugoycj_StableNormal_main && \
    git checkout --detach ${STABLENORMAL_COMMIT} && \
    test "$(git rev-parse HEAD)" = "${STABLENORMAL_COMMIT}" && \
    git rev-parse HEAD > /opt/torchhome/hub/hugoycj_StableNormal_main/VAMS_UPSTREAM_COMMIT

# The predictor loads its DINOv2 backbone through torch.hub as well, which fetches the repository as
# a zipball from GitHub on any run where the checkout is absent -- a per-run download and a runtime
# dependency on GitHub being reachable from a private subnet. The directory name is the one torch.hub
# derives for a branch checkout, so a pre-populated checkout is used as-is.
RUN git clone https://github.com/facebookresearch/dinov2.git \
        /opt/torchhome/hub/facebookresearch_dinov2_main && \
    cd /opt/torchhome/hub/facebookresearch_dinov2_main && \
    git checkout --detach ${DINOV2_COMMIT} && \
    test "$(git rev-parse HEAD)" = "${DINOV2_COMMIT}" && \
    git rev-parse HEAD > /opt/torchhome/hub/facebookresearch_dinov2_main/VAMS_UPSTREAM_COMMIT

# Backend selection read by the upstream modules at import. SPARSE_ATTN_BACKEND is set explicitly
# because the sparse module falls back to its own default rather than following ATTN_BACKEND when the
# value is one it does not accept.
ENV SPARSE_BACKEND=spconv
ENV SPCONV_ALGO=native
ENV ATTN_BACKEND=xformers
ENV SPARSE_ATTN_BACKEND=xformers

# Fail the build here rather than on a GPU instance. A CPU-only torch, an xformers resolved against a
# different torch, or a missing sparse backend all import cleanly enough to pass a naive check, so the
# CUDA build tag is asserted rather than merely printed. The upstream package itself is imported to
# confirm its own import-time backend checks pass; nothing here needs a GPU present.
RUN python -c "import torch, xformers, xformers.ops, spconv; \
assert torch.version.cuda, 'torch was resolved without CUDA support'; \
print('torch', torch.__version__, 'cuda', torch.version.cuda, 'xformers', xformers.__version__)" && \
    python -c "import hi3dgen; from hi3dgen.pipelines import Hi3DGenPipeline; print('hi3dgen imports')" && \
    python -c "import diffusers, transformers; from diffusers.models import AutoencoderKL; \
print('diffusers', diffusers.__version__, 'transformers', transformers.__version__)"

# The normal predictor's DINOv2 backbone is fetched by torch.hub into the hub cache on first use.
# Baking it in keeps a 1.1 GB download out of every run: the hub cache lives in the image rather than
# on the shared EFS mount, so nothing would carry it between jobs.
ARG DINOV2_CHECKPOINT_SHA256=36e4deffbaef061a2576705b0c36f93621e2ae20bf6274694821b0b492551b51
RUN mkdir -p /opt/torchhome/hub/checkpoints && \
    curl -fsSL -o /opt/torchhome/hub/checkpoints/dinov2_vitl14_reg4_pretrain.pth \
    https://dl.fbaipublicfiles.com/dinov2/dinov2_vitl14/dinov2_vitl14_reg4_pretrain.pth && \
    echo "${DINOV2_CHECKPOINT_SHA256}  /opt/torchhome/hub/checkpoints/dinov2_vitl14_reg4_pretrain.pth" | sha256sum -c -

# The upstream package is imported by the adapter's driver script, which runs with the repo root as
# its working directory; adding it to PYTHONPATH keeps the import working from anywhere.
ENV PYTHONPATH="/opt/stable3dgen:${PYTHONPATH}"

# The installed set is exactly the lock: this fails the build on any package that is missing, extra or at
# another version than locks/stable3dgen names (the GPL pair only when it was requested), and pip check
# confirms the declared dependencies of what is installed. The import check confirms the CUDA torch build
# survived and the repair stack the pipeline's own code is written against is present.
RUN python /opt/locks/tools/check_installed_set.py --dir /opt/locks/stable3dgen --gpl "$ENABLE_GPL_MESH_REPAIR" && \
    pip check
RUN python -c "import trimesh, manifold3d, torch; \
assert torch.version.cuda, 'the locked install displaced the CUDA torch build'; \
print('trimesh', trimesh.__version__, 'torch', torch.__version__)"

# rembg resolves its segmentation weights under U2NET_HOME and downloads them on first use,
# defaulting to a home directory nothing carries between jobs -- which had the preprocessing stage
# re-fetching 176 MB on every run and taking longer than the reconstruction itself. Pointing the
# variable at a baked-in copy removes the download entirely.
ENV U2NET_HOME=/opt/rembg
# Checked against its SHA-256; it is the same file rembg's own download checks by MD5.
ARG U2NET_SHA256=8d10d2f3bb75ae3b6d527c77944fc5e7dcd94b29809d47a739a7a728a912b491
RUN mkdir -p /opt/rembg && \
    curl -fsSL -o /opt/rembg/u2net.onnx \
    https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx && \
    echo "${U2NET_SHA256}  /opt/rembg/u2net.onnx" | sha256sum -c -

# VAMS container code
COPY __init__.py __main__.py model_manager.py preprocess.py framing.py generate.py benchmark.py meshcleanup.py printfeatures.py texturing.py export.py agent_broker.py config.json entrypoint.sh /opt/ml/code/
COPY models /opt/ml/code/models
COPY vams_utils /opt/ml/code/vams_utils
COPY hfguard /opt/ml/code/hfguard
# Strip CRLF line endings from entrypoint.sh in case the source was bundled from a Windows working
# tree; otherwise the shebang becomes `/bin/bash\r` and the kernel returns ENOENT on exec.
# COPY keeps the build host's mode bits, so a checkout made under umask 077 or 027 would leave files
# the runtime user cannot read: a+rX normalizes them.
RUN sed -i 's/\r$//' /opt/ml/code/entrypoint.sh && chmod +x /opt/ml/code/entrypoint.sh && \
    chmod -R a+rX /opt/ml/code
# The upstream checkout is the working directory of the model's process, and an upstream tool may
# create files relative to it. Group vams and mode 1775 let the runtime user add entries while the
# sticky bit keeps the root-owned sources as they are. HOME belongs to the runtime user.
# torch.hub creates $TORCH_HOME/hub/trusted_list on first use when it is missing, and the runtime user
# cannot write the root-owned hub directory (PermissionError on the upstream DINOv2 load), so the image
# carries the empty file. facebookresearch is a trusted owner, so torch.hub never writes to it.
RUN chgrp vams /opt/stable3dgen && chmod 1775 /opt/stable3dgen && chown -R vams:vams /home/vams && \
    touch /opt/torchhome/hub/trusted_list
# Every HuggingFace download in this image is held to its pinned commit (hfguard/hf_pins.py). Checked
# at build time, so an image whose huggingface_hub lacks what the guard wraps fails here rather than
# on its first run.
RUN cd /opt/ml/code && python -c "from hfguard import hf_pins; assert hf_pins.install(), 'huggingface_hub is missing'"
# The modules a Stable3DGen job runs import with the locked set alone. The lock leaves gradio out (only the
# upstream demo apps import it), so this loads the pipeline's entry module without running it, the modules its
# code imports inside functions, the Stable3DGen pipeline, the StableNormal predictor the driver loads through
# torch.hub and the DINOv2 hub the predictor loads in turn (by file, because StableNormal's is already `hubconf`),
# and fails the build on a module that needs a package the lock does not hold. The entry module creates its S3
# client at import; with the instance metadata lookup off, that reaches no network during the build.
RUN cd /opt/ml/code && AWS_EC2_METADATA_DISABLED=true python -c "import importlib, importlib.util, sys; \
assert importlib.util.find_spec('gradio') is None, 'gradio is installed, but the lock leaves it out'; \
spec = importlib.util.spec_from_file_location('job_entry', '__main__.py'); \
spec.loader.exec_module(importlib.util.module_from_spec(spec)); \
[importlib.import_module(m) for m in ('framing', 'models.stable3dgen', 'rembg', 'onnxruntime', 'manifold3d', \
'xatlas', 'scipy', 'torchvision', 'transformers', 'huggingface_hub')]; \
from hi3dgen.pipelines import Hi3DGenPipeline; \
sys.path.insert(0, '/opt/torchhome/hub/hugoycj_StableNormal_main'); import hubconf; \
sys.path.insert(0, '/opt/torchhome/hub/facebookresearch_dinov2_main'); \
dino = importlib.util.spec_from_file_location('dinov2_hubconf', '/opt/torchhome/hub/facebookresearch_dinov2_main/hubconf.py'); \
dino.loader.exec_module(importlib.util.module_from_spec(dino)); \
print('Stable3DGen job modules import')"

WORKDIR /opt/ml/code
USER 10000:10000
ENTRYPOINT ["/opt/ml/code/entrypoint.sh"]
