# VAMS Image to 3D Pipeline Container -- Stable-X Stable3DGen (Hi3DGen)
# Upstream: https://github.com/Stable-X/Stable3DGen (MIT)
# Weights:  https://huggingface.co/Stable-X/trellis-normal-v0-1 (MIT, geometry pipeline)
#           https://huggingface.co/Stable-X/yoso-normal-v1-8-1 (Apache-2.0, StableNormal predictor)
#           https://huggingface.co/ZhengPeng7/BiRefNet (MIT, background removal)
# Normal predictor code: https://github.com/hugoycj/StableNormal (Apache-2.0)
#
# Hi3DGen reconstructs geometry by bridging through a predicted normal map. It carries none of the
# NVIDIA-licensed components the TRELLIS lineage depends on -- kaolin, nvdiffrast and FlexiCubes are
# replaced by its own marching-cubes implementation over scikit-image -- so nothing here is built from
# source and the image raises no redistribution question. The model produces geometry only.

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# The upstream repo is pinned to a reviewed commit so the image is reproducible. An empty value
# clones the default branch, which makes the build non-reproducible: set this to a commit that has
# been reviewed before deploying.
ARG STABLE3DGEN_COMMIT="c29f668ecec44b197275e9bf77f823c0c8a21076"
# The normal predictor is loaded through torch.hub from a local checkout rather than fetched at run
# time, so its revision is pinned here too. Pinning it is not optional in practice: its hub entry
# point's signature has already moved away from what Stable3DGen's own demo calls it with, so a
# floating revision breaks the run rather than merely making the image irreproducible.
ARG STABLENORMAL_COMMIT="1b7203c988384cb62286a25865d7354be8fdbbf7"
# The predictor's backbone is itself pulled through torch.hub, which reaches GitHub at run time
# unless the checkout is already present. Pinned and baked in for the same reasons.
ARG DINOV2_COMMIT="7764ea0f912e53c92e82eb78a2a1631e92725fc8"
# The GPL-3.0 mesh-repair rungs (pymeshfix, pymeshlab) complete the repair ladder. A run selects
# which rungs it walks through the template's REPAIR_BACKENDS setting.
ARG ENABLE_GPL_MESH_REPAIR=true

# Install system dependencies. The GL/EGL libraries back trimesh's rendering paths and pymeshlab's
# plugins; libopengl0 is what pymeshlab's texture defragmentation filter links against.
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    git-lfs \
    libegl1 \
    xvfb \
    libgl1 \
    libopengl0 \
    libglu1-mesa \
    libgles2 \
    libglib2.0-0 \
    python3 \
    python3-dev \
    python3-venv \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN git lfs install

# Install AWS CLI v2
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

# Ubuntu 24.04 marks its system python as externally managed, so the pipeline and the upstream repo
# share one virtualenv that fronts PATH.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV=/opt/venv
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# torch, torchvision and xformers are installed together from the CUDA 12.8 index so all three come
# from one set of CUDA-enabled builds. The versions are pinned as a pair: xformers 0.0.34 declares
# torch==2.10.0 exactly, and resolving xformers from PyPI instead would pull its own CPU-only torch
# over this one. xformers is not optional -- the sparse attention module accepts only 'xformers' or
# 'flash_attn' and raises at import for anything else, so unlike the dense path it has no sdpa
# fallback, and flash_attn would mean the source compile this image exists to avoid.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 \
    torch==2.10.0 torchvision xformers==0.0.34

# Shared pipeline dependencies
COPY requirements.txt /opt/ml/code/requirements.txt
RUN pip install --no-cache-dir -r /opt/ml/code/requirements.txt

# Clone Stable3DGen and install its dependency stack. Everything it declares is a plain wheel.
RUN git clone https://github.com/Stable-X/Stable3DGen.git /opt/stable3dgen && \
    if [ -n "$STABLE3DGEN_COMMIT" ]; then \
        git -C /opt/stable3dgen checkout "$STABLE3DGEN_COMMIT"; \
    else \
        echo "WARNING: STABLE3DGEN_COMMIT is unset; this image tracks the default branch and is not reproducible"; \
    fi
WORKDIR /opt/stable3dgen
# No CUDA extension is compiled in this image, so this list only affects any wheel that consults it.
# Ampere (8.6) covers g5 / A10G, Ada (8.9) covers g6 / L4 and g6e / L40S, Hopper (9.0) covers H100.
ENV TORCH_CUDA_ARCH_LIST="8.6;8.9;9.0"
RUN pip install --no-cache-dir -r requirements.txt

# Upstream pins transformers exactly but leaves diffusers unbounded, and the two have diverged:
# diffusers 0.37 added an autoencoder whose module imports Dinov2WithRegistersConfig from
# transformers, a name the pinned transformers does not carry. The autoencoders package imports that
# module eagerly, so the failure hits any diffusers.models import -- which is the first thing the
# normal predictor does. pip cannot see the conflict because diffusers declares transformers only as
# a test extra, so the bound is applied here rather than left to resolution.
RUN pip install --no-cache-dir "diffusers<0.37"

# The sparse convolution backend. spconv-cu126 is the newest variant publishing a cp312 wheel --
# spconv-cu120 has none, so naming it here would fail the build on this image's Python. A cu126 build
# runs against the CUDA 12.8 runtime through minor version compatibility.
RUN pip install --no-cache-dir spconv-cu126

# The normal predictor is loaded with torch.hub source='local', which expects the checkout under the
# hub directory named the way torch.hub names a GitHub repo: {owner}_{repo}_{branch}.
ENV TORCH_HOME=/opt/torchhome
RUN mkdir -p /opt/torchhome/hub && \
    git clone https://github.com/hugoycj/StableNormal.git /opt/torchhome/hub/hugoycj_StableNormal_main && \
    if [ -n "$STABLENORMAL_COMMIT" ]; then \
        git -C /opt/torchhome/hub/hugoycj_StableNormal_main checkout "$STABLENORMAL_COMMIT"; \
    else \
        echo "WARNING: STABLENORMAL_COMMIT is unset; this image tracks the default branch and is not reproducible"; \
    fi

# The predictor loads its DINOv2 backbone through torch.hub as well, which fetches the repository as
# a zipball from GitHub on any run where the checkout is absent -- a per-run download and a runtime
# dependency on GitHub being reachable from a private subnet. The directory name is the one torch.hub
# derives for a branch checkout, so a pre-populated checkout is used as-is.
RUN git clone https://github.com/facebookresearch/dinov2.git \
        /opt/torchhome/hub/facebookresearch_dinov2_main && \
    if [ -n "$DINOV2_COMMIT" ]; then \
        git -C /opt/torchhome/hub/facebookresearch_dinov2_main checkout "$DINOV2_COMMIT"; \
    else \
        echo "WARNING: DINOV2_COMMIT is unset; this image tracks the default branch and is not reproducible"; \
    fi

# Backend selection read by the upstream modules at import. SPARSE_ATTN_BACKEND is set explicitly
# because the sparse module falls back to its own default rather than following ATTN_BACKEND when the
# value is one it does not accept.
ENV SPARSE_BACKEND=spconv
ENV SPCONV_ALGO=native
ENV ATTN_BACKEND=xformers
ENV SPARSE_ATTN_BACKEND=xformers

# Fail the build here rather than on a GPU instance. A CPU-only torch, an xformers resolved against a
# different torch, or a missing sparse backend all import cleanly enough to pass a naive check, so the
# CUDA build tag is asserted rather than merely printed. The upstream package itself is imported to
# confirm its own import-time backend checks pass; nothing here needs a GPU present.
RUN python -c "import torch, xformers, xformers.ops, spconv; \
assert torch.version.cuda, 'torch was resolved without CUDA support'; \
print('torch', torch.__version__, 'cuda', torch.version.cuda, 'xformers', xformers.__version__)" && \
    python -c "import hi3dgen; from hi3dgen.pipelines import Hi3DGenPipeline; print('hi3dgen imports')" && \
    python -c "import diffusers, transformers; from diffusers.models import AutoencoderKL; \
print('diffusers', diffusers.__version__, 'transformers', transformers.__version__)"

# The normal predictor's DINOv2 backbone is fetched by torch.hub into the hub cache on first use.
# Baking it in keeps a 1.1 GB download out of every run: the hub cache lives in the image rather than
# on the shared EFS mount, so nothing would carry it between jobs.
RUN mkdir -p /opt/torchhome/hub/checkpoints && \
    curl -fsSL -o /opt/torchhome/hub/checkpoints/dinov2_vitl14_reg4_pretrain.pth \
    https://dl.fbaipublicfiles.com/dinov2/dinov2_vitl14/dinov2_vitl14_reg4_pretrain.pth && \
    python -c "import os; p='/opt/torchhome/hub/checkpoints/dinov2_vitl14_reg4_pretrain.pth'; \
size=os.path.getsize(p); assert size > 500_000_000, f'the DINOv2 checkpoint is only {size} bytes'; \
print('dinov2 checkpoint', size, 'bytes')"

# The upstream package is imported by the adapter's driver script, which runs with the repo root as
# its working directory; adding it to PYTHONPATH keeps the import working from anywhere.
ENV PYTHONPATH="/opt/stable3dgen:${PYTHONPATH}"

# GPL-3.0 mesh-repair rungs, installed only when the operator opts in
RUN if [ "$ENABLE_GPL_MESH_REPAIR" = "true" ]; then \
        echo "Installing GPL-3.0 mesh repair backends (pymeshfix, pymeshlab)" && \
        pip install --no-cache-dir pymeshfix pymeshlab; \
    else \
        echo "GPL mesh repair backends not installed (ENABLE_GPL_MESH_REPAIR=$ENABLE_GPL_MESH_REPAIR)"; \
    fi

# A model repo's own requirements are installed after the shared ones and can pull a shared
# dependency backwards -- Stable3DGen pins numpy 1.26.4, and the pipeline's own code is written
# against the versions in the shared file. Reasserting the shared constraint here restores them, and
# the import check confirms the torch stack survived it.
COPY requirements.txt /opt/ml/code/requirements.txt
RUN pip install --no-cache-dir -r /opt/ml/code/requirements.txt && \
    python -c "import trimesh, manifold3d, torch; \
assert torch.version.cuda, 'the shared requirements displaced the CUDA torch build'; \
print('trimesh', trimesh.__version__, 'torch', torch.__version__)"

# rembg resolves its segmentation weights under U2NET_HOME and downloads them on first use,
# defaulting to a home directory nothing carries between jobs -- which had the preprocessing stage
# re-fetching 176 MB on every run and taking longer than the reconstruction itself. Pointing the
# variable at a baked-in copy removes the download entirely.
ENV U2NET_HOME=/opt/rembg
RUN mkdir -p /opt/rembg && \
    curl -fsSL -o /opt/rembg/u2net.onnx \
    https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx && \
    python -c "import os; p='/opt/rembg/u2net.onnx'; size=os.path.getsize(p); \
assert size > 150_000_000, f'the u2net weights are only {size} bytes'; print('u2net', size, 'bytes')"

# VAMS container code
COPY __init__.py __main__.py model_manager.py preprocess.py framing.py generate.py benchmark.py meshcleanup.py printfeatures.py texturing.py export.py agent_broker.py config.json entrypoint.sh /opt/ml/code/
COPY models /opt/ml/code/models
COPY vams_utils /opt/ml/code/vams_utils
# Strip CRLF line endings from entrypoint.sh in case the source was bundled from a Windows working
# tree; otherwise the shebang becomes `/bin/bash\r` and the kernel returns ENOENT on exec.
RUN sed -i 's/\r$//' /opt/ml/code/entrypoint.sh && chmod +x /opt/ml/code/entrypoint.sh

WORKDIR /opt/ml/code
ENTRYPOINT ["/opt/ml/code/entrypoint.sh"]
