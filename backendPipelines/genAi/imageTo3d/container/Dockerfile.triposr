# VAMS Image to 3D Pipeline Container -- VAST-AI TripoSR
# Upstream: https://github.com/VAST-AI-Research/TripoSR (MIT)
# Weights: https://huggingface.co/stabilityai/TripoSR (MIT)

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# The upstream repo is pinned to a reviewed commit so the image is reproducible. An empty value
# clones the default branch, which makes the build non-reproducible: set this to a commit that has
# been reviewed before deploying.
ARG TRIPOSR_COMMIT=""
# The GPL-3.0 mesh-repair rungs (pymeshfix, pymeshlab) complete the repair ladder. A run selects
# which rungs it walks through the template's REPAIR_BACKENDS setting.
ARG ENABLE_GPL_MESH_REPAIR=true

# Install system dependencies. libgl1/libglib2.0-0 back pillow and trimesh's rendering paths,
# libegl1/libgles2 back TripoSR's moderngl texture bake.
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    curl \
    git \
    git-lfs \
    ninja-build \
    libegl1 \
    xvfb \
    libgl1 \
    libopengl0 \
    libglu1-mesa \
    libgles2 \
    libglib2.0-0 \
    python3 \
    python3-dev \
    python3-venv \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN git lfs install

# Install AWS CLI v2
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

# Ubuntu 24.04 marks its system python as externally managed, so the pipeline and the upstream repo
# share one virtualenv that fronts PATH.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV=/opt/venv
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# CUDA 12.8 torch stack. TripoSR builds a CUDA extension (torchmcubes) against this torch, so it is
# installed before the repo.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 \
    torch torchvision

# Shared pipeline dependencies
COPY requirements.txt /opt/ml/code/requirements.txt
RUN pip install --no-cache-dir -r /opt/ml/code/requirements.txt

# Clone TripoSR and install its own dependency stack. torchmcubes is the marching-cubes CUDA
# extension the triplane decoder surfaces through, and is not on PyPI.
RUN git clone https://github.com/VAST-AI-Research/TripoSR.git /opt/triposr && \
    if [ -n "$TRIPOSR_COMMIT" ]; then \
        git -C /opt/triposr checkout "$TRIPOSR_COMMIT"; \
    else \
        echo "WARNING: TRIPOSR_COMMIT is unset; this image tracks the default branch and is not reproducible"; \
    fi
WORKDIR /opt/triposr
# Every GPU family the pipeline can schedule onto has to be in this list, or an extension
# compiles for the wrong architecture and fails at runtime with "no kernel image is available
# for execution on the device". Ampere (8.6) covers g5 / A10G, Ada (8.9) covers g6 / L4 and
# g6e / L40S, and Hopper (9.0) covers H100.
ENV TORCH_CUDA_ARCH_LIST="8.6;8.9;9.0"
# The texture bake rasterizes the UV atlas through moderngl, which defaults to an X11 context and
# fails with "XOpenDisplay: cannot open display" on a headless AWS Batch host. EGL renders offscreen
# against the GPU with no display server, so the backend is selected explicitly.
ENV MODERNGL_WINDOW=headless
ENV PYOPENGL_PLATFORM=egl
ENV GLCONTEXT_BACKEND=egl
# torchmcubes is the marching-cubes CUDA extension, built here from a pinned commit. Its build has
# three traps. Its scikit-build-core backend imports torch while preparing metadata, so an isolated
# build has no torch and fails with "must be built against an installed PyTorch" -- the backend is
# installed into the venv first and isolation is disabled. The repo's own requirements.txt pins the
# same torchmcubes URL, so it is dropped from that file to avoid a second, isolated build. And its
# CMakeLists forces C++20, under which GCC 13's <cmath> declares std::lerp -- pulled into scope by the
# torch/thrust headers the .cu files include -- and it collides with the global lerp in the vendored
# NVIDIA helper_math.h; the extension compiles cleanly under C++17, so the standard is lowered before
# the install. A plain set() in CMakeLists overrides a -D cache value, so the file is edited directly,
# anchored on the exact lines so the build fails loudly if upstream changes them.
ARG TORCHMCUBES_COMMIT=879926d0ef58e6ce0ac2630fdecb5e53af7ed3ff
RUN sed -i '/torchmcubes/d' requirements.txt && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir scikit-build-core pybind11 && \
    git clone https://github.com/tatsy/torchmcubes.git /opt/torchmcubes && \
    git -C /opt/torchmcubes checkout --detach "$TORCHMCUBES_COMMIT" && \
    test "$(git -C /opt/torchmcubes rev-parse HEAD)" = "$TORCHMCUBES_COMMIT" && \
    grep -q 'set(CMAKE_CXX_STANDARD 20)' /opt/torchmcubes/CMakeLists.txt && \
    grep -q 'set(CMAKE_CUDA_STANDARD 20)' /opt/torchmcubes/CMakeLists.txt && \
    sed -i 's/set(CMAKE_CXX_STANDARD 20)/set(CMAKE_CXX_STANDARD 17)/; s/set(CMAKE_CUDA_STANDARD 20)/set(CMAKE_CUDA_STANDARD 17)/' /opt/torchmcubes/CMakeLists.txt && \
    pip install --no-cache-dir --no-build-isolation /opt/torchmcubes

# The upstream texture bake samples colours through a CPU tensor while the model is loaded on the
# GPU, so it raises a device mismatch on every GPU run and the mesh ships untextured. The patch
# script exits non-zero when the pinned revision no longer matches the text it rewrites, which fails
# the build rather than producing an image whose bake silently cannot work.
COPY patches/triposr_bake_texture_device.py /opt/ml/code/patches/triposr_bake_texture_device.py
RUN python /opt/ml/code/patches/triposr_bake_texture_device.py /opt/triposr/tsr/bake_texture.py

# GPL-3.0 mesh-repair rungs, installed only when the operator opts in
RUN if [ "$ENABLE_GPL_MESH_REPAIR" = "true" ]; then \
        echo "Installing GPL-3.0 mesh repair backends (pymeshfix, pymeshlab)" && \
        pip install --no-cache-dir pymeshfix pymeshlab; \
    else \
        echo "GPL mesh repair backends not installed (ENABLE_GPL_MESH_REPAIR=$ENABLE_GPL_MESH_REPAIR)"; \
    fi

# A model repo's own requirements are installed after the shared ones and can pull a shared
# dependency backwards -- TripoSR pins trimesh 4.0.5, whose manifold backend calls an API that
# manifold3d 3.x removed, silently disabling the manifold repair rung. Reasserting the shared
# constraint here restores the version the pipeline's own code is written against.
COPY requirements.txt /opt/ml/code/requirements.txt
RUN pip install --no-cache-dir -r /opt/ml/code/requirements.txt && python -c "import trimesh, manifold3d; print('trimesh', trimesh.__version__)"

# rembg resolves its segmentation weights under U2NET_HOME and downloads them on first use,
# defaulting to a home directory nothing carries between jobs -- which had the preprocessing stage
# re-fetching 176 MB on every run and taking longer than the reconstruction itself. Pointing the
# variable at a baked-in copy removes the download entirely.
ENV U2NET_HOME=/opt/rembg
RUN mkdir -p /opt/rembg && \
    curl -fsSL -o /opt/rembg/u2net.onnx \
    https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx && \
    python -c "import os; p='/opt/rembg/u2net.onnx'; size=os.path.getsize(p); \
assert size > 150_000_000, f'the u2net weights are only {size} bytes'; print('u2net', size, 'bytes')"

# VAMS container code
COPY __init__.py __main__.py model_manager.py preprocess.py framing.py generate.py benchmark.py meshcleanup.py printfeatures.py texturing.py export.py agent_broker.py config.json entrypoint.sh /opt/ml/code/
COPY models /opt/ml/code/models
COPY vams_utils /opt/ml/code/vams_utils
# Strip CRLF line endings from entrypoint.sh in case the source was bundled from a Windows working
# tree; otherwise the shebang becomes `/bin/bash\r` and the kernel returns ENOENT on exec.
RUN sed -i 's/\r$//' /opt/ml/code/entrypoint.sh && chmod +x /opt/ml/code/entrypoint.sh

WORKDIR /opt/ml/code
ENTRYPOINT ["/opt/ml/code/entrypoint.sh"]
