{
    "pipelineName": "SYSTEM - GenAI Metadata Generation",
    "category": "SYSTEM - GenAI",
    "description": "Analyses every viewer-supported file with Amazon Bedrock: writes sys_* file attributes, typed ext_* file metadata and a GeoJSON location, and genai_* file metadata for each file, and, when vector search is enabled, publishes a per-file-version embedding for natural-language search. A system pipeline: read-only through the API except its enabled switch.",
    "isSystem": true,
    "executionConfig": {
        "executionType": "Lambda",
        "waitForCallback": "Enabled",
        "taskTimeout": "18000",
        "taskHeartbeatTimeout": "",
        "lambda": {}
    },
    "systemConfig": {
        "inputFileArity": "one",
        "assetScope": {
            "wholeAsset": false
        },
        "metadataInputs": {
            "assetMetadata": true,
            "fileMetadata": true,
            "fileAttributes": true,
            "databaseMetadata": true
        },
        "requireTemplate": false,
        "allowCustomTemplateOverride": true,
        "inputFileFilters": {
            "allow": [
