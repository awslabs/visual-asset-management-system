FROM --platform=linux/amd64 condaforge/mambaforge:24.9.2-0 as build

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN conda create -n pdal -y

# v2.7.0
ARG GITHUB_SHA="4f63a07556041a7a21ad02fd5d32844701732003" 
ARG GITHUB_REPOSITORY="PDAL/PDAL"
ARG GITHUB_SERVER_URL="https://github.com"

SHELL ["conda", "run", "-n", "pdal", "/bin/bash", "-c"]

RUN mamba install -c conda-forge git compilers conda-pack cmake make ninja boto3 sysroot_linux-64=2.17 && \
    mamba install --yes -c conda-forge pdal=2.7.0 --only-deps

RUN git clone "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}" pdal && \
    cd pdal ; \
    git checkout ${GITHUB_SHA}

RUN mkdir -p pdal/build && \
    cd pdal/build  && \
    CXXFLAGS="-Werror=strict-aliasing" LDFLAGS="-Wl,-rpath-link,$CONDA_PREFIX/lib" cmake -G Ninja  \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_LIBRARY_PATH:FILEPATH="$CONDA_PREFIX/lib" \
    -DCMAKE_INCLUDE_PATH:FILEPATH="$CONDA_PREFIX/include" \
    -DCMAKE_INSTALL_PREFIX="$CONDA_PREFIX" \
    -DBUILD_PLUGIN_CPD=OFF \
    -DBUILD_PLUGIN_PGPOINTCLOUD=ON \
    -DBUILD_PLUGIN_NITF=ON \
    -DBUILD_PLUGIN_ICEBRIDGE=ON \
    -DBUILD_PLUGIN_HDF=ON \
    -DBUILD_PLUGIN_TILEDB=ON \
    -DBUILD_PLUGIN_E57=ON \
    -DBUILD_PGPOINTCLOUD_TESTS=OFF \
    -DWITH_TESTS=OFF \
    -DWITH_ZSTD=ON \
    ..

RUN cd pdal/build  && \
    ninja

# Skipping ctest -V: tests are not built (-DWITH_TESTS=OFF) because the
# tiledb-plugin gtest objects fail to link against newer gtest versions
# (undefined references to testing::internal::MakeAndRegisterTestInfo etc.).
# The published v2.7.0 tag is upstream; we don't need the test suite to ship
# the runtime container.
#RUN cd pdal/build  && \
#    ctest -V

RUN cd pdal/build  && \
    ninja install

RUN conda-pack -n pdal --dest-prefix=/opt/conda/envs/pdal -o  /tmp/env.tar && \
    mkdir /venv && cd /venv && tar xf /tmp/env.tar  && \
    rm /tmp/env.tar

# Runtime stage platform must match the build stage: the PDAL binaries are copied from /venv
FROM --platform=linux/amd64 condaforge/miniforge3:26.5.3-0

ENV CONDAENV="/opt/conda/envs/pdal"
COPY --from=build /venv "/opt/conda/envs/pdal"

ENV PROJ_NETWORK=TRUE
ENV PROJ_DATA="${CONDAENV}/share/proj"
ENV GDAL_DATA="${CONDAENV}/share/gdal"
ENV GEOTIFF_CSV="${CONDAENV}/share/epsg_csv"
ENV GDAL_DRIVER_PATH="${CONDAENV}/lib/gdalplugins"
ENV PATH=$PATH:${CONDAENV}/bin
ENV GTIFF_REPORT_COMPD_CS=TRUE
ENV REPORT_COMPD_CS=TRUE
ENV OAMS_TRADITIONAL_GIS_ORDER=TRUE

# copy python scripts app to container
COPY ./ ./pc_pipeline

#Install requirements (boto3, etc.)
RUN conda install -c conda-forge --file ./pc_pipeline/requirements.txt

# Create the runtime user. This stage needs its own: a user created in the `build` stage above is
# discarded with it, and uncommenting it there would fail this stage's USER with "unable to find user".
#
# HOME has to exist and be writable. This stage's ENTRYPOINT runs under `conda run`, which reads HOME
# and writes to it, and a system account with no home directory makes that fail at container start
# rather than at build. No WORKDIR is set here, so create_dir(["tmp", "input"]) resolves against / and
# lands in the 1777 /tmp, which any user can write.
RUN useradd --create-home --uid 10001 --user-group appuser
ENV HOME=/home/appuser

#Switch user to app user for runtime operations
USER appuser

SHELL ["conda", "run", "--no-capture-output", "-n", "pdal", "/bin/sh", "-c"]
ENTRYPOINT ["python3", "-m", "pc_pipeline"]
