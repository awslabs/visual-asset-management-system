{
    "pipelineName": "Media Preview Thumbnail",
    "category": "Preview",
    "description": "Generate preview thumbnails (JPG/PNG/GIF) for images and video: an image the web already shows as its own preview is skipped, TGA and TIFF always get a JPG - .png, .jpg, .jpeg, .gif, .webp, .bmp, .tga, .tif, .tiff, .mp4, .m4v, .mov, .mkv, .webm, .avi, .wmv, .mpg, .mpeg, .mts, .m2ts",
    "executionConfig": {
        "executionType": "Lambda",
        "waitForCallback": "Enabled",
        "taskTimeout": "14400",
        "taskHeartbeatTimeout": "",
        "lambda": {}
    },
    "systemConfig": {
        "inputFileArity": "one",
        "assetScope": {
            "wholeAsset": false
        },
        "metadataInputs": {
            "assetMetadata": false,
            "fileMetadata": false,
            "fileAttributes": false
        },
        "requireTemplate": false,
        "allowCustomTemplateOverride": true,
        "inputFileFilters": {
            "allow": [
                "*.png",
                "*.jpg",
                "*.jpeg",
                "*.gif",
                "*.webp",
                "*.bmp",
                "*.tga",
                "*.tif",
                "*.tiff",
                "*.mp4",
                "*.m4v",
                "*.mov",
                "*.mkv",
                "*.webm",
                "*.avi",
                "*.wmv",
                "*.mpg",
                "*.mpeg",
                "*.mts",
                "*.m2ts"
            ],
            "exclude": []
        }
    }
}
